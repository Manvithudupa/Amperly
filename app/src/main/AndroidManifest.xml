<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Car App Library template access. The projected experience uses MapWithContentTemplate
      (RouteOverviewCarScreen) through the POI (EV charging) category, so MAP_TEMPLATES is the
      declaration the host requires. Navigation is handed off to the phone's maps application,
      so neither the navigation template permission nor the navigation category is declared.
    -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <!-- Required to receive the map Surface that CarMap paints into. -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <!-- Handing navigation off to an installed maps application -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- Needed so the release host validator can read the host's signing certificate. -->
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.apps.automotive.templates.host" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Amperly">

        <!--
          The map is drawn by MapLibre Native from a Geoapify-hosted vector style, and address
          search and routing are plain HTTPS calls. None of that needs a manifest entry or a
          key here: the key is read from local.properties into BuildConfig, so it never appears
          in version control. A missing key shows an actionable notice rather than a blank map
          (see MapConfig).
        -->

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- Flutter v2 embedding. The phone activity above owns this engine. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
          The handset is Flutter. Android Auto is not: it never starts this activity and keeps
          its own CarAppService below. The configChanges list is the Flutter embedding contract;
          the engine handles rotation and insets without recreating the activity.
        -->
        <activity
            android:name=".FlutterPhoneActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Email-confirmation return path. The app deliberately does not read a token or a
              status out of this intent: a custom scheme can be fired by any installed app, so
              nothing it carries can be treated as proof that an address was confirmed. The
              person returns to the sign-in screen and signs in with the confirmed address.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="amperly"
                    android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!--
          Exported because the Android Auto host is a different application and can only bind
          to an exported car app service; the androidx.car.app contract has no permission it
          could require instead. tools:ignore records why lint's ExportedService warning does
          not apply here.
        -->
        <service
            android:name=".car.AmperlyCarAppService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <!--
                  POI is the current category for EV charging: CHARGING is deprecated since
                  Car App Library 1.3, so a host that only understands POI would otherwise
                  never list this app.
                -->
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

    </application>

</manifest>
