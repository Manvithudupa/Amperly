<?xml version="1.0" encoding="utf-8"?>
<!--
  Round launcher icon for API 24-25: the same plate and mark, cut to a circle because those
  launchers draw the round icon as it is rather than masking it the way API 26+ does.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF0B0D11" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
