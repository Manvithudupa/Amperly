<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================================================================ Type -->
    <!--
      Plus Jakarta Sans, three weights, four sizes: Display 28, Title 20, Body 16,
      Label 13. Numbers get tabular figures so columns of kWh and rupees line up.
    -->

    <style name="TextAppearance.Amperly.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/pjs_bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.12</item>
        <item name="android:textColor">@color/amp_ink</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Amperly.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/pjs_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textColor">@color/amp_ink</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Amperly.TitleSmall" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/pjs_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/amp_ink</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Amperly.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/pjs_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
        <item name="android:textColor">@color/amp_ink</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Amperly.BodySmall" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/pjs_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
        <item name="android:textColor">@color/amp_ink_secondary</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Amperly.BodyStrong" parent="TextAppearance.Amperly.Body">
        <item name="android:fontFamily">@font/pjs_medium</item>
        <item name="android:textColor">@color/amp_ink</item>
    </style>

    <style name="TextAppearance.Amperly.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/pjs_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="android:textColor">@color/amp_ink_secondary</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Amperly.LabelStrong" parent="TextAppearance.Amperly.Label">
        <item name="android:textColor">@color/amp_ink</item>
    </style>

    <!-- A number the screen is built around. Tabular, so it does not jitter. -->
    <style name="TextAppearance.Amperly.Metric" parent="TextAppearance.Amperly.Display">
        <item name="android:textSize">30sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/amp_ink</item>
    </style>

    <style name="TextAppearance.Amperly.MetricSmall" parent="TextAppearance.Amperly.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.Amperly.Number" parent="TextAppearance.Amperly.Body">
        <item name="android:fontFamily">@font/pjs_medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>


    <style name="TextAppearance.Amperly.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/pjs_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Amperly.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/pjs_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Amperly.NavLabel.Active" parent="TextAppearance.Amperly.NavLabel">
        <item name="android:fontFamily">@font/pjs_bold</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Amperly.Wordmark" parent="TextAppearance.Amperly.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/amp_primary</item>
    </style>

    <!-- ============================================================= Buttons -->

    <style name="Widget.Amperly.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/amp_touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/amp_field_radius</item>
        <item name="backgroundTint">@color/amp_primary</item>
        <item name="android:textColor">@color/amp_on_primary</item>
        <item name="iconTint">@color/amp_on_primary</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Widget.Amperly.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/amp_touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/amp_field_radius</item>
        <item name="backgroundTint">@color/amp_surface_variant</item>
        <item name="android:textColor">@color/amp_ink</item>
        <item name="iconTint">@color/amp_ink</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Amperly.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/amp_touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/amp_field_radius</item>
        <item name="strokeColor">@color/amp_divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/amp_primary</item>
        <item name="iconTint">@color/amp_primary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!--
      A compact outlined button that carries a value rather than an action: the booking code on
      a reservation row. Small enough to sit inside a row, still a full tap target.
    -->
    <style name="Widget.Amperly.Button.Code" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/amp_touch_target</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="cornerRadius">@dimen/amp_chip_radius</item>
        <item name="strokeColor">@color/amp_divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/amp_primary</item>
        <item name="iconTint">@color/amp_primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Amperly.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/amp_touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/amp_primary</item>
        <item name="iconTint">@color/amp_primary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- The one amber call to action. Ink on amber, never white. -->
    <style name="Widget.Amperly.Button.Energy" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/amp_touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/amp_field_radius</item>
        <item name="backgroundTint">@color/amp_energy</item>
        <item name="android:textColor">@color/amp_on_energy</item>
        <item name="iconTint">@color/amp_on_energy</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Amperly.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/amp_touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/amp_field_radius</item>
        <item name="backgroundTint">@color/amp_error</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Legacy alias kept for any screen still referencing the old name. -->

    <!-- =============================================================== Cards -->

    <style name="Widget.Amperly.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/amp_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/amp_surface</item>
        <item name="strokeColor">@color/amp_divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.Amperly.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/amp_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/amp_surface_variant</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- No box at all: a grouping surface for a section that is already on the page. -->
    <style name="Widget.Amperly.Card.Plain" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/amp_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Amperly.Card.Map" parent="Widget.Amperly.Card">
        <item name="cardBackgroundColor">@color/amp_surface_variant</item>
    </style>


    <!-- Kept so an old reference cannot break the build; no gradient, no dark hero. -->

    <!-- =============================================================== Chips -->

    <style name="Widget.Amperly.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipCornerRadius">@dimen/amp_chip_radius</item>
        <item name="chipBackgroundColor">@color/amp_chip_bg</item>
        <item name="android:textColor">@color/amp_chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="checkedIconTint">@color/amp_primary</item>
        <item name="chipStartPadding">14dp</item>
        <item name="chipEndPadding">14dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <!-- Status text: always words, never a bare dot of colour. -->
    <style name="Widget.Amperly.Badge" parent="">
        <item name="android:background">@drawable/bg_badge_neutral</item>
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Label</item>
        <item name="android:textColor">@color/amp_ink_secondary</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.Amperly.Badge.Success">
        <item name="android:background">@drawable/bg_badge_success</item>
        <item name="android:textColor">@color/amp_available</item>
    </style>



    <style name="Widget.Amperly.Badge.Info">
        <item name="android:background">@drawable/bg_badge_info</item>
        <item name="android:textColor">@color/amp_info</item>
    </style>

    <style name="Widget.Amperly.Badge.Neutral">
        <item name="android:background">@drawable/bg_badge_neutral</item>
        <item name="android:textColor">@color/amp_ink_secondary</item>
    </style>


    <!-- Legacy name, same neutral treatment. -->

    <!-- ============================================================= Notices -->

    <style name="Widget.Amperly.Notice" parent="">
        <item name="android:background">@drawable/bg_notice_neutral</item>
        <item name="android:padding">@dimen/amp_space_m</item>
        <item name="android:textAppearance">@style/TextAppearance.Amperly.BodySmall</item>
        <item name="android:textColor">@color/amp_ink</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="Widget.Amperly.Notice.Info">
        <item name="android:background">@drawable/bg_notice_info</item>
        <item name="android:textColor">@color/amp_info</item>
    </style>

    <style name="Widget.Amperly.Notice.Warning">
        <item name="android:background">@drawable/bg_notice_warning</item>
        <item name="android:textColor">@color/amp_busy_ink</item>
    </style>

    <style name="Widget.Amperly.Notice.Error">
        <item name="android:background">@drawable/bg_notice_error</item>
        <item name="android:textColor">@color/amp_error</item>
    </style>



    <!-- ============================================================== Inputs -->

    <style name="Widget.Amperly.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/amp_field_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/amp_field_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/amp_field_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/amp_field_radius</item>
        <item name="boxStrokeColor">@color/amp_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxBackgroundColor">@color/amp_surface</item>
        <item name="hintTextColor">@color/amp_ink_secondary</item>
        <item name="android:textColorHint">@color/amp_ink_secondary</item>
        <item name="errorTextColor">@color/amp_error</item>
        <item name="endIconTint">@color/amp_ink_secondary</item>
        <item name="startIconTint">@color/amp_ink_secondary</item>
        <item name="android:minHeight">@dimen/amp_touch_target</item>
    </style>

    <!-- ================================================ Rows, dividers, labels -->

    <style name="Widget.Amperly.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/amp_divider</item>
    </style>

    <style name="Widget.Amperly.SheetHandle" parent="">
        <item name="android:layout_width">@dimen/amp_sheet_handle_width</item>
        <item name="android:layout_height">@dimen/amp_sheet_handle_height</item>
        <item name="android:background">@drawable/bg_sheet_handle</item>
    </style>


    <!-- Left-hand label of an itemised row; the value sits in a right column. -->
    <style name="Widget.Amperly.RowLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Body</item>
        <item name="android:textColor">@color/amp_ink_secondary</item>
    </style>

    <style name="Widget.Amperly.RowValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/amp_space_m</item>
        <item name="android:gravity">end</item>
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Number</item>
        <item name="android:textColor">@color/amp_ink</item>
    </style>


    <!-- A sticky action bar at the bottom of a screen: surface, hairline, real padding. -->
    <style name="Widget.Amperly.StickyActionBar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/amp_surface</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/amp_screen_padding</item>
        <item name="android:paddingEnd">@dimen/amp_screen_padding</item>
        <item name="android:paddingTop">@dimen/amp_space_s</item>
        <item name="android:paddingBottom">@dimen/amp_space_s</item>
    </style>

    <!-- Numeral in a circle, used by the route stepper and the stop timeline. -->
    <style name="Widget.Amperly.StepNumber" parent="">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/bg_step_number</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/pjs_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/amp_primary_dark</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Amperly.ScreenBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/amp_screen_padding</item>
        <item name="android:paddingEnd">@dimen/amp_screen_padding</item>
        <item name="android:paddingBottom">@dimen/amp_space_xl</item>
    </style>

    <style name="Widget.Amperly.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/amp_section_gap</item>
        <item name="android:layout_marginBottom">@dimen/amp_space_s</item>
        <item name="android:textAppearance">@style/TextAppearance.Amperly.TitleSmall</item>
    </style>

    <!-- ================================================== Bottom navigation -->

    <style name="ShapeAppearance.Amperly.NavIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.Amperly.NavIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="shapeAppearance">@style/ShapeAppearance.Amperly.NavIndicator</item>
        <item name="android:color">@color/amp_primary_tint</item>
    </style>

    <!-- ============================================================== Toolbar -->

    <style name="Widget.Amperly.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/amp_background</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.Amperly.Title</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Amperly.Label</item>
        <item name="titleTextColor">@color/amp_ink</item>
    </style>

    <!-- Legacy header container, now just a plain block. -->

    <!-- Legacy role chip, kept for the account page's capacity switcher. -->
    <style name="Widget.Amperly.RoleChip" parent="Widget.Amperly.Chip" />

    <!-- ================================================== Feedback and menus -->

    <!--
      Themed feedback. A Snackbar uses the inverse surface role (already declared in the
      theme), so it reads correctly in light and dark mode without a night override.
    -->
    <style name="Widget.Amperly.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">?attr/colorSurfaceInverse</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Amperly.Medium</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="Widget.Amperly.SnackbarButton" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">?attr/colorOnSurfaceInverse</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!--
      Dropdown list popup and overflow menu. The Material 3 parents already draw the app's
      surface colour and rounded shape, so the theme only has to name them once.
    -->
    <style name="Widget.Amperly.PopupWindow" parent="Widget.Material3.PopupMenu.ListPopupWindow" />

    <style name="Widget.Amperly.PopupMenu" parent="Widget.Material3.PopupMenu" />

    <!-- ================================== Transitional aliases ============== -->
    <!-- Old layout names, pointed at the new scale. Removed once every screen
         has been rebuilt against the current style names. -->



    <style name="TextAppearance.Amperly.SectionTitle" parent="TextAppearance.Amperly.TitleSmall" />


</resources>
