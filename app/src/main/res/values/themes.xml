<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Amperly's design system.

      Translated from the UI prototype: four type sizes on a warm serif (Fraunces) for
      anything that is a heading or a number, one grotesque (DM Sans) for everything that is
      read, white cards with a hairline on a paper background, and a single lime accent that
      only ever carries dark green ink.

      Every screen is built from these styles, so changing a token here changes the whole app
      without touching a fragment.
    -->

    <style name="Base.Theme.Amperly" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/amp_primary</item>
        <item name="colorOnPrimary">@color/amp_on_primary</item>
        <item name="colorPrimaryContainer">@color/amp_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/amp_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/amp_primary_light</item>

        <item name="colorSecondary">@color/amp_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/amp_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/amp_on_secondary_container</item>

        <item name="colorTertiary">@color/amp_tertiary</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/amp_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/amp_on_tertiary_container</item>

        <item name="colorError">@color/amp_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/amp_error_container</item>
        <item name="colorOnErrorContainer">@color/amp_on_error_container</item>

        <item name="android:colorBackground">@color/amp_surface</item>
        <item name="colorSurface">@color/amp_surface</item>
        <item name="colorSurfaceContainerLowest">@color/amp_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/amp_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/amp_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/amp_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/amp_surface_container_highest</item>
        <item name="colorSurfaceVariant">@color/amp_surface_variant</item>
        <item name="colorOnSurface">@color/amp_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/amp_on_surface_variant</item>
        <item name="colorOutline">@color/amp_outline</item>
        <item name="colorOutlineVariant">@color/amp_outline_variant</item>

        <!-- Type: DM Sans is the reading face; Fraunces is applied by the heading styles. -->
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="fontFamily">@font/dm_sans</item>

        <!-- Edge-to-edge: the bars are transparent and the shell pads itself from insets. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- The app bar is now a light surface, so the status bar icons must be dark. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="materialCardViewStyle">@style/Widget.Amperly.Card</item>
        <item name="materialButtonStyle">@style/Widget.Amperly.Button</item>
        <item name="chipStyle">@style/Widget.Amperly.Chip</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Amperly.Dialog</item>
    </style>

    <style name="Theme.Amperly" parent="Base.Theme.Amperly" />

    <style name="ThemeOverlay.Amperly.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Amperly.Dialog</item>
    </style>

    <style name="ShapeAppearance.Amperly.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- ============================================================== Buttons -->
    <!--
      The prototype's primary action is a lime pill with dark green ink — not the usual
      Material filled button. Tonal is the soft lime wash used for secondary actions.
      All corners are 11dp (12dp at the large size) so buttons line up with the input fields.
    -->

    <style name="Widget.Amperly.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/amp_touch_target</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/amp_lime</item>
        <item name="android:textColor">@color/amp_on_lime</item>
        <item name="iconTint">@color/amp_on_lime</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Amperly.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/amp_touch_target</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/amp_lime_soft</item>
        <item name="android:textColor">@color/amp_primary</item>
        <item name="iconTint">@color/amp_primary</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Amperly.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/amp_touch_target</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/amp_field_border</item>
        <item name="android:textColor">@color/amp_primary</item>
        <item name="iconTint">@color/amp_primary</item>
    </style>

    <style name="Widget.Amperly.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/amp_touch_target</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/amp_primary</item>
        <item name="iconTint">@color/amp_primary</item>
    </style>

    <style name="Widget.Amperly.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/amp_touch_target</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/amp_error</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Amperly.Button.Dark" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/amp_touch_target</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/amp_primary</item>
        <item name="android:textColor">@color/amp_on_primary</item>
        <item name="iconTint">@color/amp_on_primary</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- ================================================================ Cards -->
    <!-- White card, hairline border, 18dp radius, and a whisper of elevation. -->

    <style name="Widget.Amperly.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/amp_card_radius</item>
        <item name="cardElevation">@dimen/amp_card_elevation</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Amperly.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/amp_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
    </style>

    <!-- The map panel is a feature, not content: give it a filled, inset treatment. -->
    <style name="Widget.Amperly.Card.Map" parent="Widget.Amperly.Card">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
    </style>

    <!-- The dark gradient banner that opens Discover. -->
    <style name="Widget.Amperly.Card.Hero" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:background">@drawable/bg_hero</item>
    </style>

    <!-- A side card: white, 15dp radius, used for pricing and "at a glance". -->
    <style name="Widget.Amperly.Card.Side" parent="Widget.Amperly.Card">
        <item name="cardCornerRadius">16dp</item>
    </style>

    <!--
      A stat tile is a filled card that fills an equal share of its row, so
      layout_weight is part of the style rather than something every call site
      has to remember.
    -->
    <style name="Widget.Amperly.StatTile" parent="Widget.Amperly.Card">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/amp_stat_tile_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/amp_space_xs</item>
    </style>

    <!-- ================================================================= Text -->

    <!--
      Fraunces, with negative tracking, is what makes a heading read as Amperly rather than
      as generic Material. DM Sans is reserved for anything the user reads in a sentence.
    -->

    <style name="TextAppearance.Amperly.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:lineSpacingMultiplier">0.98</item>
        <item name="android:textColor">@color/amp_primary_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Amperly.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:textColor">@color/amp_primary_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Amperly.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/amp_primary_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Small all-caps kicker above a heading, e.g. "LIVE NETWORK". -->
    <style name="TextAppearance.Amperly.Eyebrow" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/amp_muted</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Amperly.BodyStrong" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Amperly.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Amperly.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- Field captions and secondary metadata. Deliberately not all-caps. -->
    <style name="TextAppearance.Amperly.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/amp_muted</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- A number the screen is built around: 26sp Fraunces in deep green. -->
    <style name="TextAppearance.Amperly.Metric" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/amp_primary_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- The largest number on a detail page, e.g. the per-kWh price. -->
    <style name="TextAppearance.Amperly.Price" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.045</item>
        <item name="android:textColor">@color/amp_primary_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Amperly.Mono" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- =============================================================== Chips -->
    <!-- Small status chips: 24dp tall, 7dp corners, tinted by state. -->

    <style name="Widget.Amperly.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAllCaps">false</item>
        <item name="chipMinHeight">34dp</item>
        <item name="chipCornerRadius">9dp</item>
        <item name="chipBackgroundColor">@color/amp_chip_bg</item>
        <item name="android:textColor">@color/amp_chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
    </style>

    <!-- Rounded status pill, e.g. the verification level on a station row. -->
    <style name="Widget.Amperly.Badge" parent="">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:textColor">@color/amp_badge_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelSmall</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- The uppercase kicker used inside a hero or a side card. -->
    <style name="Widget.Amperly.Badge.Eyebrow" parent="Widget.Amperly.Badge">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textColor">@color/amp_muted</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- ============================================================== Notices -->
    <!-- Rounded status panels: 14dp corners, tinted surface, matching ink. -->

    <style name="Widget.Amperly.Notice" parent="">
        <item name="android:background">@drawable/bg_notice_neutral</item>
        <item name="android:padding">@dimen/amp_space_m</item>
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Body</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Amperly.Notice.Info" parent="Widget.Amperly.Notice">
        <item name="android:background">@drawable/bg_notice_info</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
    </style>

    <style name="Widget.Amperly.Notice.Warning" parent="Widget.Amperly.Notice">
        <item name="android:background">@drawable/bg_notice_warning</item>
        <item name="android:textColor">?attr/colorOnTertiaryContainer</item>
    </style>

    <style name="Widget.Amperly.Notice.Error" parent="Widget.Amperly.Notice">
        <item name="android:background">@drawable/bg_notice_error</item>
        <item name="android:textColor">?attr/colorOnErrorContainer</item>
    </style>

    <style name="Widget.Amperly.Notice.Primary" parent="Widget.Amperly.Notice">
        <item name="android:background">@drawable/bg_notice_primary</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <!-- Same panel, but for machine values the user may need to read digit by digit. -->
    <style name="Widget.Amperly.Notice.Mono" parent="Widget.Amperly.Notice">
        <item name="android:textAppearance">@style/TextAppearance.Amperly.Mono</item>
    </style>

    <style name="Widget.Amperly.Badge.Info" parent="Widget.Amperly.Badge">
        <item name="android:background">@drawable/bg_badge_info</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
    </style>

    <style name="Widget.Amperly.Badge.Neutral" parent="Widget.Amperly.Badge">
        <item name="android:background">@drawable/bg_badge_neutral</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Amperly.Badge.Warning" parent="Widget.Amperly.Badge">
        <item name="android:background">@drawable/bg_badge_warning</item>
        <item name="android:textColor">?attr/colorOnTertiaryContainer</item>
    </style>

    <style name="Widget.Amperly.Badge.Error" parent="Widget.Amperly.Badge">
        <item name="android:background">@drawable/bg_badge_error</item>
        <item name="android:textColor">?attr/colorOnErrorContainer</item>
    </style>

    <!-- =============================================================== Inputs -->

    <style name="Widget.Amperly.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/amp_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="hintTextColor">@color/amp_muted</item>
    </style>

    <!-- ================================================== Bottom navigation -->

    <style name="ShapeAppearance.Amperly.NavIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!--
      Nav labels: DM Sans at 10-11sp, the weight difference carrying the selected state.
      The prototype's sidebar uses the same idea — a darker, bolder label on a lime pill —
      just rotated to a bottom bar for a phone.
    -->

    <style name="TextAppearance.Amperly.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Amperly.NavLabel.Active" parent="TextAppearance.Amperly.NavLabel">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Amperly.NavIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="shapeAppearance">@style/ShapeAppearance.Amperly.NavIndicator</item>
        <item name="android:color">@color/amp_lime_soft</item>
    </style>

    <!-- ================================================== Brand lock-up -->

    <!-- The wordmark beside the mark: Fraunces, tight tracking, deep green. -->
    <style name="TextAppearance.Amperly.Wordmark" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/amp_primary_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.04</item>
    </style>

    <!-- ================================================== Role switcher -->

    <!--
      The role switch reads as a segmented control: a soft track with a white thumb, not a row
      of independent tags. The chip style above is for status; this one is for navigation.
    -->
    <style name="Widget.Amperly.RoleChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAllCaps">false</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipCornerRadius">9dp</item>
        <item name="chipBackgroundColor">@color/amp_pill_bg</item>
        <item name="android:textColor">@color/amp_pill_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- ================================================== Section header -->

    <!-- Eyebrow + serif title + optional supporting line, used at the top of every screen. -->
    <style name="Widget.Amperly.ScreenHeader" parent="Widget.Amperly.Card">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="Widget.Amperly.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>
</resources>
