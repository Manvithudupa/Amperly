<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Amperly, calm and local: warm paper, deep green, one amber accent.

      Everything visual is declared once here or in styles.xml. A layout references a
      style; it does not repeat colours, radii or type sizes.
    -->

    <style name="Base.Theme.Amperly" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/amp_primary</item>
        <item name="colorOnPrimary">@color/amp_on_primary</item>
        <item name="colorPrimaryContainer">@color/amp_primary_tint</item>
        <item name="colorOnPrimaryContainer">@color/amp_on_primary_tint</item>

        <item name="colorSecondary">@color/amp_info</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/amp_info_tint</item>
        <item name="colorOnSecondaryContainer">@color/amp_on_secondary_container</item>

        <item name="colorTertiary">@color/amp_energy</item>
        <item name="colorOnTertiary">@color/amp_on_energy</item>
        <item name="colorTertiaryContainer">@color/amp_energy_tint</item>
        <item name="colorOnTertiaryContainer">@color/amp_busy_ink</item>

        <item name="colorError">@color/amp_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/amp_error_tint</item>
        <item name="colorOnErrorContainer">@color/amp_on_error_container</item>

        <item name="android:colorBackground">@color/amp_background</item>
        <item name="colorSurface">@color/amp_surface</item>
        <item name="colorSurfaceContainerLowest">@color/amp_surface</item>
        <item name="colorSurfaceContainerLow">@color/amp_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/amp_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/amp_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/amp_surface_container_highest</item>
        <item name="colorSurfaceVariant">@color/amp_surface_variant</item>
        <item name="colorOnSurface">@color/amp_ink</item>
        <item name="colorOnSurfaceVariant">@color/amp_ink_secondary</item>
        <item name="colorOutline">@color/amp_outline</item>
        <item name="colorOutlineVariant">@color/amp_divider</item>
        <item name="colorSurfaceInverse">@color/amp_ink</item>
        <item name="colorOnSurfaceInverse">@color/amp_background</item>

        <!-- One reading face; weight, not a second typeface, carries emphasis. -->
        <item name="android:fontFamily">@font/pjs_regular</item>
        <item name="fontFamily">@font/pjs_regular</item>

        <item name="android:windowBackground">@color/amp_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="materialCardViewStyle">@style/Widget.Amperly.Card</item>
        <item name="materialButtonStyle">@style/Widget.Amperly.Button</item>
        <item name="chipStyle">@style/Widget.Amperly.Chip</item>
        <item name="toolbarStyle">@style/Widget.Amperly.Toolbar</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Amperly.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Amperly.BottomSheet</item>

        <!-- Themed feedback: snackbars share the app's surface, shape and type. -->
        <item name="snackbarStyle">@style/Widget.Amperly.Snackbar</item>
        <item name="snackbarButtonStyle">@style/Widget.Amperly.SnackbarButton</item>

        <!-- Themed dropdowns: the popup list, not only the field, follows Material 3. -->
        <item name="listPopupWindowStyle">@style/Widget.Amperly.PopupWindow</item>
        <item name="popupMenuStyle">@style/Widget.Amperly.PopupMenu</item>

        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Amperly.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Amperly.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Amperly.Large</item>
    </style>

    <style name="Theme.Amperly" parent="Base.Theme.Amperly" />

    <style name="ShapeAppearance.Amperly.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.Amperly.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Amperly.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Amperly.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ThemeOverlay.Amperly.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Amperly.Sheet</item>
        <item name="colorSurface">@color/amp_surface</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- A dialog is its own window: it has to resize for the keyboard itself, or the field
             being typed in ends up behind the IME with the buttons pushed off screen. -->
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="ThemeOverlay.Amperly.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Amperly.BottomSheet</item>
    </style>

    <style name="Widget.Amperly.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.Amperly.Sheet</item>
        <item name="backgroundTint">@color/amp_surface</item>
        <item name="android:background">@color/amp_surface</item>
    </style>
</resources>
