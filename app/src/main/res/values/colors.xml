<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--
      Amperly colour roles, light theme.

      One warm paper background, white cards separated by a hairline, deep green for
      anything actionable, amber reserved for energy. These are ROLES, not swatches:
      layouts and drawables reference them, so the night theme is a single swap.
    -->

    <!-- Surfaces -->
    <color name="amp_background">#F6F4EE</color>
    <color name="amp_surface">#FFFFFF</color>
    <color name="amp_surface_variant">#ECE8DE</color>
    <color name="amp_surface_sunken">#EFEBE2</color>
    <color name="amp_divider">#DDD8CB</color>
    <color name="amp_outline">#C4BDAC</color>

    <!-- Ink -->
    <color name="amp_ink">#16201B</color>
    <color name="amp_ink_secondary">#5B665F</color>
    <color name="amp_ink_on_dark">#FFFFFF</color>

    <!-- Primary: deep green -->
    <color name="amp_primary">#0F5C4D</color>
    <color name="amp_primary_dark">#0B4438</color>
    <color name="amp_primary_tint">#E3EFEA</color>
    <color name="amp_on_primary">#FFFFFF</color>
    <color name="amp_on_primary_tint">#0B4438</color>

    <!-- Energy: amber, used sparingly. Always with ink, never white, on top. -->
    <color name="amp_energy">#F2A516</color>
    <color name="amp_energy_deep">#C98708</color>
    <color name="amp_energy_tint">#FDF1D8</color>
    <color name="amp_on_energy">#16201B</color>

    <!-- Status: each has an ink and a tint for chips -->
    <color name="amp_available">#2E7D4F</color>
    <color name="amp_available_tint">#E4F2E6</color>
    <color name="amp_busy">#C77700</color>
    <color name="amp_busy_ink">#8A5200</color>
    <color name="amp_busy_tint">#FBEEDA</color>
    <color name="amp_error">#B3261E</color>
    <color name="amp_error_tint">#FBE7E4</color>
    <color name="amp_info">#2F5D8A</color>
    <color name="amp_info_tint">#E7EFF7</color>

    <!-- Legacy role names kept so existing Java and drawables keep resolving -->
    <color name="amp_on_lime">@color/amp_on_energy</color>
    <color name="amp_lime">@color/amp_energy</color>
    <color name="amp_lime_deep">@color/amp_energy_deep</color>
    <color name="amp_lime_soft">@color/amp_energy_tint</color>
    <color name="amp_lime_tint">@color/amp_energy_tint</color>
    <color name="amp_primary_light">#2F7A67</color>
    <color name="amp_primary_container">@color/amp_primary_tint</color>
    <color name="amp_on_primary_container">@color/amp_on_primary_tint</color>
    <color name="amp_secondary">@color/amp_info</color>
    <color name="amp_secondary_container">@color/amp_info_tint</color>
    <color name="amp_on_secondary_container">#234A6B</color>
    <color name="amp_tertiary">@color/amp_busy</color>
    <color name="amp_tertiary_container">@color/amp_busy_tint</color>
    <color name="amp_on_tertiary_container">@color/amp_busy_ink</color>
    <color name="amp_error_container">@color/amp_error_tint</color>
    <color name="amp_on_error_container">#7F1D15</color>
    <color name="amp_surface_container_lowest">@color/amp_surface</color>
    <color name="amp_surface_container_low">#FBF9F4</color>
    <color name="amp_surface_container">@color/amp_surface_variant</color>
    <color name="amp_surface_container_high">#E4DFD3</color>
    <color name="amp_surface_container_highest">#DCD6C8</color>
    <color name="amp_on_surface">@color/amp_ink</color>
    <color name="amp_on_surface_variant">@color/amp_ink_secondary</color>
    <color name="amp_outline_variant">@color/amp_divider</color>
    <color name="amp_muted">@color/amp_ink_secondary</color>
    <color name="amp_field_border">@color/amp_divider</color>
    <color name="amp_line">@color/amp_divider</color>
    <color name="amp_card">@color/amp_surface</color>
    <color name="amp_success">@color/amp_available</color>
    <color name="amp_success_container">@color/amp_available_tint</color>
    <color name="amp_warning">@color/amp_busy</color>
    <color name="amp_warning_container">@color/amp_busy_tint</color>
    <color name="amp_badge_bg">@color/amp_available_tint</color>
    <color name="amp_badge_text">@color/amp_available</color>
    <color name="amp_map_placeholder">#E8E3D7</color>
    <color name="amp_hero_start">@color/amp_primary_dark</color>
    <color name="amp_hero_mid">@color/amp_primary</color>
    <color name="amp_hero_end">@color/amp_primary</color>
    <color name="amp_on_hero">@color/amp_on_primary</color>
    <color name="amp_on_hero_muted">@color/amp_primary_tint</color>
    <color name="amp_hero_kicker">@color/amp_energy</color>
</resources>
