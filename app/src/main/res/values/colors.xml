<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="white">#FFFFFFFF</color>

    <!--
      Amperly colour roles, light theme.

      One warm paper background, white cards separated by a hairline, deep green for
      anything actionable, amber reserved for energy. These are ROLES, not swatches:
      layouts and drawables reference them, so the night theme is a single swap.
    -->

    <!-- Surfaces -->
    <color name="amp_background">#F6F4EE</color>
    <color name="amp_surface">#FFFFFF</color>
    <color name="amp_surface_variant">#ECE8DE</color>
    <color name="amp_divider">#DDD8CB</color>
    <color name="amp_outline">#C4BDAC</color>

    <!-- Ink -->
    <color name="amp_ink">#16201B</color>
    <color name="amp_ink_secondary">#5B665F</color>

    <!-- Primary: deep green -->
    <color name="amp_primary">#0F5C4D</color>
    <color name="amp_primary_dark">#0B4438</color>
    <color name="amp_primary_tint">#E3EFEA</color>
    <color name="amp_on_primary">#FFFFFF</color>
    <color name="amp_on_primary_tint">#0B4438</color>

    <!-- Energy: amber, used sparingly. Always with ink, never white, on top. -->
    <color name="amp_energy">#F2A516</color>
    <color name="amp_energy_tint">#FDF1D8</color>
    <color name="amp_on_energy">#16201B</color>

    <!-- Status: each has an ink and a tint for chips -->
    <color name="amp_available">#2E7D4F</color>
    <color name="amp_available_tint">#E4F2E6</color>
    <color name="amp_busy">#C77700</color>
    <color name="amp_busy_ink">#8A5200</color>
    <color name="amp_busy_tint">#FBEEDA</color>
    <color name="amp_error">#B3261E</color>
    <color name="amp_error_tint">#FBE7E4</color>
    <color name="amp_info">#2F5D8A</color>
    <color name="amp_info_tint">#E7EFF7</color>

    <!-- Legacy role names kept so existing Java and drawables keep resolving -->
    <color name="amp_primary_container">@color/amp_primary_tint</color>
    <color name="amp_on_secondary_container">#234A6B</color>
    <color name="amp_on_error_container">#7F1D15</color>
    <color name="amp_surface_container_low">#FBF9F4</color>
    <color name="amp_surface_container_high">#E4DFD3</color>
    <color name="amp_surface_container_highest">#DCD6C8</color>
    <color name="amp_map_placeholder">#E8E3D7</color>
</resources>
