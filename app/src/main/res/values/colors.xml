<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--
      Amperly design tokens, taken from the UI prototype.

      These names are Material 3 ROLES, not decorative swatches. Getting them right is what
      gives the app a surface hierarchy: the 18dp-radius cards are pure white sitting on a
      warm paper background, separated by a hairline, never by a heavy shadow.

      The palette is deliberately narrow:
        lime       the one accent that means "energy / go"
        deep green the ink used for headings and primary actions
        paper      the background, never pure grey
        blue       location and route
        orange     attention without alarm
        red        the one destructive tone
    -->

    <!-- Brand: deep green carries text, lime carries energy -->
    <color name="amp_primary">#205846</color>
    <color name="amp_primary_dark">#163F34</color>
    <color name="amp_primary_light">#2F6852</color>
    <color name="amp_primary_container">#DCF6CC</color>
    <color name="amp_on_primary_container">#163F34</color>

    <!-- The signature accent. Only ever paired with dark green ink, never white text. -->
    <color name="amp_on_primary">#FFFFFF</color>
    <color name="amp_lime">#9CE96A</color>
    <color name="amp_lime_deep">#81D757</color>
    <color name="amp_lime_soft">#E8F6E3</color>
    <color name="amp_lime_tint">#F0FAEC</color>
    <color name="amp_on_lime">#163F34</color>

    <color name="amp_secondary">#4683B5</color>
    <color name="amp_secondary_container">#E1F0FF</color>
    <color name="amp_on_secondary_container">#2E678E</color>

    <color name="amp_tertiary">#A36A24</color>
    <color name="amp_tertiary_container">#FFF0D9</color>
    <color name="amp_on_tertiary_container">#7E5729</color>

    <color name="amp_error">#EF745E</color>
    <color name="amp_error_container">#FFE4DF</color>
    <color name="amp_on_error_container">#AE4E3F</color>

    <!-- Surfaces: paper is the lowest, cards step up to white -->
    <color name="amp_surface">#F5F7F2</color>
    <color name="amp_surface_container_lowest">#FFFFFF</color>
    <color name="amp_surface_container_low">#FBFCFA</color>
    <color name="amp_surface_container">#F0F4EF</color>
    <color name="amp_surface_container_high">#EAF1E8</color>
    <color name="amp_surface_container_highest">#E4EDE1</color>

    <color name="amp_surface_variant">#E5EBE5</color>
    <color name="amp_on_surface">#12221F</color>
    <color name="amp_on_surface_variant">#536561</color>
    <color name="amp_outline">#B8C7BC</color>
    <color name="amp_outline_variant">#E5EBE5</color>

    <!-- Muted text is its own token: it is lighter than on_surface_variant -->
    <color name="amp_muted">#8A9A95</color>
    <color name="amp_field_border">#D7E5D5</color>
    <color name="amp_line">#E5EBE5</color>

    <!-- Kept for compatibility with existing layouts and styles -->
    <color name="amp_card">#FFFFFFFF</color>

    <!-- Semantic status colours -->
    <color name="amp_success">#3B8051</color>
    <color name="amp_success_container">#E2F8D8</color>
    <color name="amp_warning">#A36A24</color>
    <color name="amp_warning_container">#FFF0D9</color>
    <color name="amp_info">#4683B5</color>
    <color name="amp_info_container">#E1F0FF</color>

    <!-- Status badge (verification state on a station row) -->
    <color name="amp_badge_bg">#E2F8D8</color>
    <color name="amp_badge_text">#337048</color>

    <!-- The hero strip is a three-stop gradient, exactly as in the prototype -->
    <!-- The surface behind the Google map while its tiles load -->
    <color name="amp_map_placeholder">#DCE9D5</color>

    <color name="amp_hero_start">#1F5544</color>
    <color name="amp_hero_mid">#2F6852</color>
    <color name="amp_hero_end">#466E4E</color>
    <color name="amp_on_hero">#FFFFFF</color>
    <color name="amp_on_hero_muted">#C8E2D4</color>
    <color name="amp_hero_kicker">#BCF49F</color>
</resources>
