<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ extraction rules.

  Cloud backup is switched off at the manifest level as well, because this app holds two
  things that must never leave the device in a backup blob: the Supabase session tokens and
  the Room database (email addresses, phone numbers, licence plates and meter readings).
  These exclusions are the second line of defence for OEM tools that still consult the rules.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
