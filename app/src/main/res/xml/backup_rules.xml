<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below full-backup rules.

  Same reasoning as data_extraction_rules.xml: session tokens and the local database are not
  backup content. allowBackup is already false; this file makes the intent explicit and keeps
  the exclusion correct if backup is ever re-enabled deliberately.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
