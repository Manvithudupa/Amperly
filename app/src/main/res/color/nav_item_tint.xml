<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom navigation item colours.

  Without this the bar fell back to a default tint that did not follow the theme, so the
  selected item was hard to pick out. The checked state borrows the primary-container
  "on" role, which is what the active indicator pill is drawn in.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="1.0" android:color="?attr/colorOnPrimaryContainer" android:state_checked="true" />
    <item android:alpha="1.0" android:color="?attr/colorOnSurfaceVariant" />
</selector>
