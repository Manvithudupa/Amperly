<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/amp_space_m">

    <TextView
        android:id="@+id/disputeReasonText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

    <TextView
        android:id="@+id/disputeMetaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Amperly.Label" />

    <TextView
        android:id="@+id/disputeNotesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_s"
        android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

    <TextView
        android:id="@+id/hostResponseText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_xs"
        android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

    <TextView
        android:id="@+id/evidenceText"
        style="@style/Widget.Amperly.Notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_s"
        android:fontFamily="monospace"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/enforcementText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_s"
        android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

    <View
        style="@style/Widget.Amperly.Divider"
        android:layout_marginTop="@dimen/amp_space_m" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_s"
        android:text="@string/admin_section_enforcement"
        android:textAppearance="@style/TextAppearance.Amperly.LabelStrong" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refundButton"
            style="@style/Widget.Amperly.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/admin_refund" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/freezeButton"
            style="@style/Widget.Amperly.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/amp_space_s"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/admin_freeze_payout" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/warningButton"
            style="@style/Widget.Amperly.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/admin_warning" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fineButton"
            style="@style/Widget.Amperly.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/amp_space_s"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/admin_fine" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/suspendButton"
            style="@style/Widget.Amperly.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/admin_suspend" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/banButton"
            style="@style/Widget.Amperly.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/amp_space_s"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/admin_ban"
            android:textColor="@color/amp_error"
            app:iconTint="@color/amp_error" />
    </LinearLayout>

    <View
        style="@style/Widget.Amperly.Divider"
        android:layout_marginTop="@dimen/amp_space_s" />
</LinearLayout>
