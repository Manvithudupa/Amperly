<?xml version="1.0" encoding="utf-8"?>
<!--
  One numeric field for the battery-percentage dialogs (discovery and in-app navigation).

  The field is a real TextInputLayout so an out-of-range value can be reported on the field
  itself, with the dialog staying open, instead of closing it and toasting afterwards. The
  content scrolls, so a device with a short window can still lift the field clear of the
  keyboard instead of clipping the dialog buttons.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/amp_screen_padding"
        android:paddingTop="@dimen/amp_space_s"
        android:paddingEnd="@dimen/amp_screen_padding"
        android:paddingBottom="@dimen/amp_space_xs">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/numberField"
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dialog_number_label"
            app:boxBackgroundMode="outline"
            app:helperText="@string/dialog_number_range"
            app:suffixText="@string/unit_percent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/numberInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="3"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Amperly.Number" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
