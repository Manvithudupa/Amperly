<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_background"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.Amperly.ScreenBody"
        android:paddingTop="@dimen/amp_space_l">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/safety_title"
            android:textAppearance="@style/TextAppearance.Amperly.Display" />

        <TextView
            android:id="@+id/sosNoticeText"
            style="@style/Widget.Amperly.Notice.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/safety_not_emergency" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sosButton"
            style="@style/Widget.Amperly.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/safety_trigger_sos"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/sosStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <!-- Contacts -->
        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/safety_section_contacts" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/contactsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:hint="@string/safety_contact_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/contactNameEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textAppearance="@style/TextAppearance.Amperly.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:hint="@string/safety_contact_phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/contactPhoneEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:textAppearance="@style/TextAppearance.Amperly.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addContactButton"
            style="@style/Widget.Amperly.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/safety_add_contact" />

        <!-- Live location -->
        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/safety_section_sharing" />

        <TextView
            android:id="@+id/sharingStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Amperly.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareLocationButton"
                style="@style/Widget.Amperly.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/safety_share_location" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopSharingButton"
                style="@style/Widget.Amperly.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/safety_stop_sharing" />
        </LinearLayout>

        <TextView
            android:id="@+id/emergencyNumbersText"
            style="@style/Widget.Amperly.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l" />

        <TextView
            android:id="@+id/safetyHistoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />
    </LinearLayout>
</ScrollView>
