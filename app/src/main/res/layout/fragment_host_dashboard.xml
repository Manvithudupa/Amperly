<?xml version="1.0" encoding="utf-8"?>
<!--
  Host dashboard. Three numbers at the top, then the chargers, next bookings and sessions —
  all as divided rows rather than a grid of cards.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hostScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_background"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.Amperly.ScreenBody"
        android:paddingTop="@dimen/amp_space_l">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_dashboard"
            android:textAppearance="@style/TextAppearance.Amperly.Display"
            android:accessibilityHeading="true" />

        <TextView
            android:id="@+id/hostNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <!-- Three numbers, one baseline. Utilization follows as a sentence. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statsSessionsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Amperly.Metric" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_sessions_short"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statsEnergyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Amperly.Metric" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_energy_short"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statsRevenueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Amperly.Metric" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_revenue_short"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/statsUtilizationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/registerNewStationButton"
            style="@style/Widget.Amperly.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/host_register_title" />

        <TextView
            android:id="@+id/hostEmptyText"
            style="@style/Widget.Amperly.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/host_no_stations"
            android:visibility="gone" />

        <!-- Chargers -->
        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/details_ports" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stationsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Bookings -->
        <TextView
            android:id="@+id/hostBookingsSection"
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/host_tab_reservations" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/reservationsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Sessions -->
        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/host_tab_sessions" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sessionsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Analytics -->
        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/host_tab_analytics" />

        <LinearLayout
            android:id="@+id/analyticsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/analyticsNoteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />
    </LinearLayout>
</ScrollView>
