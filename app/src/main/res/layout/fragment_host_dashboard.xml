<?xml version="1.0" encoding="utf-8"?>
<!--
  Host dashboard. The numbers at the top, then the analytics, the chargers and their sessions.
  Bookings have their own tab, and the destructive action sits last, alone, away from the
  daily controls.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hostScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_background"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.Amperly.ScreenBody"
        android:paddingTop="@dimen/amp_space_l">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_dashboard"
            android:textAppearance="@style/TextAppearance.Amperly.Display"
            android:accessibilityHeading="true" />

        <TextView
            android:id="@+id/hostNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <!-- Three numbers, one baseline. Utilization follows as a sentence. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statsIncomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Amperly.Metric" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_income_short"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statsDisputesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Amperly.Metric" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_disputes_short"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statsReservationsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Amperly.Metric" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_reservations_short"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/statsUtilizationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <!-- Red, because a host with nothing listed has nothing to earn from yet. -->
        <TextView
            android:id="@+id/hostEmptyText"
            style="@style/Widget.Amperly.Notice.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/host_no_stations"
            android:visibility="gone" />

        <!-- Analytics: the numbers are the page; the station cards live on the Stations tab. -->
        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/host_tab_analytics" />

        <LinearLayout
            android:id="@+id/analyticsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/analyticsNoteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />

        <!-- Sessions -->
        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/host_tab_sessions" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sessionsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Destructive, so it stands alone at the bottom of the page. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteStationButton"
            style="@style/Widget.Amperly.Button.DeleteStation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xl"
            android:text="@string/host_delete_station" />
    </LinearLayout>
</ScrollView>
