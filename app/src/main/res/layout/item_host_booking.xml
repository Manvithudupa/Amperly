<?xml version="1.0" encoding="utf-8"?>
<!--
  One booking at a host's charger. The booking code is a chip on the left that opens the same
  QR screen the consumer sees, and the two things a host needs from a booking — the conversation
  and the receipt — sit on their own row below it.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Amperly.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/amp_space_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/amp_space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hostBookingCodeButton"
                style="@style/Widget.Amperly.Button.Code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="220dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/hostBookingStatusText"
                style="@style/Widget.Amperly.Badge.Neutral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s" />
        </LinearLayout>

        <TextView
            android:id="@+id/hostBookingStationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

        <TextView
            android:id="@+id/hostBookingDriverText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <TextView
            android:id="@+id/hostBookingSlotText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hostBookingChatButton"
                style="@style/Widget.Amperly.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/host_booking_chat" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hostBookingReceiptButton"
                style="@style/Widget.Amperly.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/host_booking_receipt" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
