<?xml version="1.0" encoding="utf-8"?>
<!--
  The garage.

  The page is a list, not a form: saved cars are cards, and editing happens on
  its own screen so the garage stays scannable. The Add a car action sits below
  the list, where a new card would appear.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/amp_screen_padding"
    android:paddingEnd="@dimen/amp_screen_padding"
    android:paddingBottom="@dimen/amp_space_m">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_l"
        android:text="@string/vehicle_garage_heading"
        android:textAppearance="@style/TextAppearance.Amperly.Display"
        android:accessibilityHeading="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_xs"
        android:text="@string/vehicle_garage_intro"
        android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/amp_space_m"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vehicleList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/amp_space_s"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/vehicleEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/amp_space_xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_vehicle"
                app:tint="@color/amp_ink_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_s"
                android:gravity="center"
                android:text="@string/vehicle_empty_title"
                android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_xs"
                android:gravity="center"
                android:text="@string/vehicle_empty_body"
                android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addVehicleButton"
        style="@style/Widget.Amperly.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_m"
        android:text="@string/vehicle_add_car"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart" />
</LinearLayout>
