<?xml version="1.0" encoding="utf-8"?>
<!-- Report dialog. Scrolls, so the multiline details field and the dialog's own buttons stay
     above the keyboard while the driver types. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/amp_screen_padding"
        android:paddingTop="@dimen/amp_space_s"
        android:paddingEnd="@dimen/amp_screen_padding"
        android:paddingBottom="@dimen/amp_space_xs">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/reportTypeField"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/report_reason">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/reportTypeDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/report_reason"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/reportDetailsField"
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:hint="@string/report_details">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/reportDetailsEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:textAppearance="@style/TextAppearance.Amperly.Body" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
