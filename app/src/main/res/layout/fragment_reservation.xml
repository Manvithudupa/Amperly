<?xml version="1.0" encoding="utf-8"?>
<!--
  Reserve a port.

  The form reads like a booking slip: where, when, what it should cost, what the policy is,
  then one reservation action. The price is labelled as an estimate because the bill is
  settled from verified meter readings afterwards. Payments are not collected in this build.

-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.Amperly.ScreenBody"
        android:paddingTop="@dimen/amp_space_l">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reserve_title"
            android:textAppearance="@style/TextAppearance.Amperly.Display"
            android:accessibilityHeading="true" />

        <TextView
            android:id="@+id/reserveStationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chooseStationButton"
            style="@style/Widget.Amperly.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/reserve_choose_station" />

        <LinearLayout
            android:id="@+id/bookingFormContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- ===================================================== Vehicle -->
            <!-- The car this booking is for; a second car is one tap away. -->
            <TextView
                style="@style/Widget.Amperly.SectionTitle"
                android:text="@string/booking_vehicle_section" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Amperly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/bookingVehicleRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/amp_touch_target"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/amp_space_m"
                    android:paddingEnd="@dimen/amp_space_m">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_vehicle"
                        app:tint="@color/amp_primary" />

                    <TextView
                        android:id="@+id/bookingVehicleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/amp_space_s"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/vehicle_none_add"
                        android:textAppearance="@style/TextAppearance.Amperly.Body" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/amp_space_xs"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        app:tint="@color/amp_ink_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================== Slot -->
            <TextView
                style="@style/Widget.Amperly.SectionTitle"
                android:text="@string/reserve_slot" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Amperly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/amp_space_m">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/portField"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/reserve_port">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/portDropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/reserve_port"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/slotField"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/amp_space_m"
                        android:hint="@string/reserve_slot">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/slotDropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/reserve_slot"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/slotHintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/amp_space_xs"
                        android:textAppearance="@style/TextAppearance.Amperly.Label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================= Price -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_section_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/details_price_breakdown"
                    android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

                <TextView
                    style="@style/Widget.Amperly.Badge.Info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_estimate" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Amperly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_s">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/amp_space_m">

                    <TextView
                        android:id="@+id/priceEnergyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Amperly.Body"
                        android:textColor="@color/amp_ink_secondary" />

                    <TextView
                        android:id="@+id/priceServiceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/amp_space_xs"
                        android:textAppearance="@style/TextAppearance.Amperly.Body"
                        android:textColor="@color/amp_ink_secondary" />

                    <TextView
                        android:id="@+id/priceGatewayText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/amp_space_xs"
                        android:textAppearance="@style/TextAppearance.Amperly.Body"
                        android:textColor="@color/amp_ink_secondary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/amp_space_m"
                        android:layout_marginBottom="@dimen/amp_space_m"
                        android:background="@drawable/bg_dashed_divider" />

                    <TextView
                        android:id="@+id/priceTotalText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.Amperly.MetricSmall" />

                    <TextView
                        android:id="@+id/priceNoteText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/amp_space_xs"
                        android:textAppearance="@style/TextAppearance.Amperly.Label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ====================================================== Policy -->
            <TextView
                style="@style/Widget.Amperly.SectionTitle"
                android:text="@string/reserve_policy_title" />

            <TextView
                android:id="@+id/policyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

            <TextView
                android:id="@+id/meterWarningText"
                style="@style/Widget.Amperly.Notice.Warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_m"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/authorizeButton"
                style="@style/Widget.Amperly.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_l"
                android:text="@string/action_reserve" />
        </LinearLayout>

        <!--
          A plain line of body text, not a badge. This view reports what happened to the
          booking ("Choose a charger first.", all ports busy, the recorded total), so it reads
          as part of the page rather than as a highlighted callout that competes with the
          Reserve button above it.

          It is hidden until there is something to say. Drawn empty it was a blank rounded box
          under the Reserve button, which read as a disabled control rather than as a message
          area.
        -->
        <TextView
            android:id="@+id/reserveStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Amperly.Body"
            android:visibility="gone" />

        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/reserve_my_reservations" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/reservationsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/reservationsEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reserve_no_reservations"
            android:textAppearance="@style/TextAppearance.Amperly.Body"
            android:textColor="@color/amp_ink_secondary"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
