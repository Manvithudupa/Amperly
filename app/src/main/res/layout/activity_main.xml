<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!--
      The top bar is a light surface now, matching the prototype's white topbar: the lime
      brand square and the serif wordmark carry the identity, not a coloured app bar.

      Its background deliberately covers the status bar area too: MainActivity pads this
      view by the top window inset, and padding sits INSIDE a view's background, so the
      colour extends behind the clock instead of leaving a gap. Required because targetSdk
      35 enforces edge-to-edge on Android 15.
    -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLowest"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurfaceContainerLowest"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/TextAppearance.Amperly.Wordmark"
            app:titleTextColor="@color/amp_primary_dark" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Hairline under the bar: the prototype separates surfaces with a line, not a shadow. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <!--
      Role switch, drawn as a segmented control.

      The chips are built at runtime from the roles the account actually holds
      (see MainActivity#buildRoleChips), because an Amperly account is dual-role: Consumer and
      Host are always offered together and Admin only appears for platform operations.
    -->
    <LinearLayout
        android:id="@+id/roleStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:orientation="vertical"
        android:paddingStart="@dimen/amp_screen_padding"
        android:paddingTop="@dimen/amp_space_s"
        android:paddingEnd="@dimen/amp_screen_padding"
        android:paddingBottom="@dimen/amp_space_s">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment_track"
            android:padding="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/roleChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="4dp"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/currentUserText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Padded by the bottom window inset at runtime so its surface fills the gesture bar. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLowest"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@style/Widget.Amperly.NavIndicator"
        app:itemIconTint="@color/nav_item_tint"
        app:itemTextColor="@color/nav_item_tint"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
