<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!--
      The app bar carries the brand colour. Its background deliberately covers the status
      bar area too: MainActivity pads this view by the top window inset, and padding sits
      INSIDE a view's background, so the colour extends behind the clock instead of
      leaving a gap. Required because targetSdk 35 enforces edge-to-edge on Android 15.
    -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:subtitle="@string/pilot_subtitle"
            app:subtitleTextColor="?attr/colorOnPrimary"
            app:title="@string/app_name"
            app:titleTextColor="?attr/colorOnPrimary" />
    </com.google.android.material.appbar.AppBarLayout>

    <!--
      Role switch. This was a large tinted card pinned above every screen, which consumed
      roughly 120dp of prime space on all 15 screens. It is now a slim, neutral strip that
      reads as a mode selector rather than a demo control.

      The chips are built at runtime from the roles the account actually holds
      (see MainActivity#buildRoleChips), because an Amperly account is dual-role: Consumer and
      Host are always offered together and Admin only appears for platform operations.
    -->
    <LinearLayout
        android:id="@+id/roleStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLow"
        android:orientation="vertical"
        android:paddingStart="@dimen/amp_screen_padding"
        android:paddingTop="@dimen/amp_space_s"
        android:paddingEnd="@dimen/amp_screen_padding"
        android:paddingBottom="@dimen/amp_space_s">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/roleChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/amp_space_xs"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/currentUserText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Padded by the bottom window inset at runtime so its surface fills the gesture bar. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@style/Widget.Amperly.NavIndicator"
        app:itemIconTint="@color/nav_item_tint"
        app:itemTextColor="@color/nav_item_tint"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
