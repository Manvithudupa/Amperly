<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!--
      The top bar is the prototype's white bar, not a coloured app bar: the lime brand
      square with the bolt, then the serif wordmark with the lime full stop. The identity is
      drawn as a lock-up so the mark and the name read as one object, exactly as they do in
      the prototype's topbar.

      Its background deliberately covers the status bar area too: MainActivity pads this
      view by the top window inset, and padding sits INSIDE a view's background, so the
      colour extends behind the clock instead of leaving a gap. Required because targetSdk
      35 enforces edge-to-edge on Android 15.
    -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLowest"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="?attr/colorSurfaceContainerLowest"
            app:contentInsetStart="16dp"
            app:contentInsetStartWithNavigation="0dp">

            <!-- Brand lock-up. Tapping it goes home; the profile chip sits in the actions. -->
            <LinearLayout
                android:id="@+id/brandLockup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_brand_mark">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_brand_mark"
                        app:tint="@color/amp_on_lime" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="@string/brand_wordmark"
                    android:textAppearance="@style/TextAppearance.Amperly.Wordmark" />

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_dot_lime" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Hairline under the bar: the prototype separates surfaces with a line, not a shadow. -->
    <View
        android:id="@+id/appBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <!--
      Role switch, drawn as a segmented control.

      The chips are built at runtime from the roles the account actually holds
      (see MainActivity#buildRoleChips), because an Amperly account is dual-role: Consumer and
      Host are always offered together and Admin only appears for platform operations.

      The signed-in person's name and capacity live in the top bar's profile chip rather than
      as a line of text here, so the bar answers "who am I acting as" in one place.
    -->
    <LinearLayout
        android:id="@+id/roleStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:orientation="vertical"
        android:paddingStart="@dimen/amp_screen_padding"
        android:paddingTop="@dimen/amp_space_s"
        android:paddingEnd="@dimen/amp_screen_padding"
        android:paddingBottom="@dimen/amp_space_s">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment_track"
            android:padding="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/roleChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="4dp"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!--
      Padded by the bottom window inset at runtime so its surface fills the gesture bar.
      Its background draws the hairline that separates the bar from the content, so the line
      disappears with the bar on the sign-in screen instead of floating there on its own.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@style/Widget.Amperly.NavIndicator"
        app:itemHorizontalTranslationEnabled="false"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/nav_item_tint"
        app:itemPaddingBottom="8dp"
        app:itemPaddingTop="8dp"
        app:itemTextAppearanceActive="@style/TextAppearance.Amperly.NavLabel.Active"
        app:itemTextAppearanceInactive="@style/TextAppearance.Amperly.NavLabel"
        app:itemTextColor="@color/nav_item_tint"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
