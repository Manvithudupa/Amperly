<?xml version="1.0" encoding="utf-8"?>
<!--
  Booking code.

  This screen is shown to another person (the Host scanning it), so the code is the
  hero: a white card that always contrasts with the QR image, the human-readable
  code underneath it in monospace, and the actions out of the way at the bottom.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/amp_screen_padding"
        android:paddingBottom="@dimen/amp_space_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YOUR BOOKING"
            android:textAppearance="@style/TextAppearance.Amperly.Eyebrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_title"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Amperly.ScreenTitle" />

        <!--
          Pinned to the lightest surface role on purpose: a QR code has to keep its
          dark-on-light contrast even when the rest of the app is in dark mode.
        -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Amperly.Card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            app:cardBackgroundColor="@color/white">

            <ImageView
                android:id="@+id/qrImageView"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:contentDescription="@string/qr_title"
                android:padding="@dimen/amp_space_s" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/bookingCodeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:letterSpacing="0.12"
            android:textAppearance="@style/TextAppearance.Amperly.Mono"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/qrStationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Amperly.BodyStrong" />

        <TextView
            android:id="@+id/qrSlotText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Amperly.Body" />

        <TextView
            android:id="@+id/qrHintText"
            style="@style/Widget.Amperly.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/qr_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/goToSessionButton"
            style="@style/Widget.Amperly.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/session_check_in" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeButton"
            style="@style/Widget.Amperly.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:text="@string/action_close" />
    </LinearLayout>
</ScrollView>
