<?xml version="1.0" encoding="utf-8"?>
<!--
  Booking code. This is shown to someone else, so the QR keeps a pure white card in both
  themes and the human-readable code sits under it in tabular monospace.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_background"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.Amperly.ScreenBody"
        android:paddingTop="@dimen/amp_space_l">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qr_title"
            android:textAppearance="@style/TextAppearance.Amperly.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:text="@string/qr_hint"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Amperly.Card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/amp_space_l"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/white">

            <ImageView
                android:id="@+id/qrImageView"
                android:layout_width="@dimen/amp_qr_size"
                android:layout_height="@dimen/amp_qr_size"
                android:contentDescription="@string/qr_title"
                android:padding="@dimen/amp_space_m" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/bookingCodeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:textAppearance="@style/TextAppearance.Amperly.Title"
            android:textColor="@color/amp_ink"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/qrStationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

        <TextView
            android:id="@+id/qrSlotText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <TextView
            android:id="@+id/qrHintText"
            style="@style/Widget.Amperly.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/qr_notice" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/goToSessionButton"
            style="@style/Widget.Amperly.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/session_check_in" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeButton"
            style="@style/Widget.Amperly.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:text="@string/action_close" />
    </LinearLayout>
</ScrollView>
