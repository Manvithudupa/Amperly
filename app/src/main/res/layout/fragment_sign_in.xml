<?xml version="1.0" encoding="utf-8"?>
<!--
  Sign in / create account.

  This is the only way into the app, because every read and write is authorised against the
  signed-in Supabase account: with no session, Row Level Security returns no rows at all.

  There is deliberately no "continue offline" path. A local demo identity would show rows the
  server would never authorise, which is exactly the fabricated data this build removes.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/amp_screen_padding"
        android:paddingTop="@dimen/amp_space_xl"
        android:paddingBottom="@dimen/amp_space_xl">

        <!-- Brand lock-up: the lime square and the serif wordmark -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_brand_mark">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_brand_mark"
                    app:tint="@color/amp_on_lime" />
            </FrameLayout>

            <TextView
                android:id="@+id/signInTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Amperly.Wordmark" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xl"
            android:fontFamily="@font/fraunces"
            android:letterSpacing="-0.04"
            android:text="Welcome back."
            android:textAppearance="@style/TextAppearance.Amperly.Display" />

        <TextView
            android:id="@+id/signInTaglineText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/app_tagline"
            android:textAppearance="@style/TextAppearance.Amperly.Body" />

        <TextView
            android:id="@+id/signInIntroText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/auth_intro"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Amperly.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/amp_space_m">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="EMAIL"
                    android:textAppearance="@style/TextAppearance.Amperly.Eyebrow" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailInputLayout"
                    style="@style/Widget.Amperly.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/signInEmailEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_m"
                    android:layout_marginBottom="6dp"
                    android:text="PASSWORD"
                    android:textAppearance="@style/TextAppearance.Amperly.Eyebrow" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordInputLayout"
                    style="@style/Widget.Amperly.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_password"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/signInPasswordEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/signInProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/signInErrorText"
            style="@style/Widget.Amperly.Notice.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:visibility="gone" />

        <TextView
            android:id="@+id/signInInfoText"
            style="@style/Widget.Amperly.Notice.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signInButton"
            style="@style/Widget.Amperly.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/auth_sign_in" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createAccountButton"
            style="@style/Widget.Amperly.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/auth_create_account" />

        <TextView
            android:id="@+id/signInOfflineNoteText"
            style="@style/Widget.Amperly.Notice.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/auth_offline_note"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:drawablePadding="6dp"
            android:text="Every station, reservation and meter reading comes from your Amperly account."
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />
    </LinearLayout>
</ScrollView>
