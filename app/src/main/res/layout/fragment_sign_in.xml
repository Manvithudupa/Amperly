<?xml version="1.0" encoding="utf-8"?>
<!--
  Sign in / create account.

  No illustration, no centred hero: the name sits where a studio would put it, one line
  says what the app is for, and the fields are the page. Every read and write is
  authorised against the signed-in account, so there is no offline way in.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/amp_screen_padding"
        android:paddingTop="@dimen/amp_space_xl"
        android:paddingEnd="@dimen/amp_screen_padding"
        android:paddingBottom="@dimen/amp_space_xl">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_brand_mark">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_brand_mark"
                    app:tint="@color/amp_on_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/signInTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/brand_wordmark"
                android:textAppearance="@style/TextAppearance.Amperly.Wordmark"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xxl"
            android:text="@string/auth_title"
            android:textAppearance="@style/TextAppearance.Amperly.Display" />

        <TextView
            android:id="@+id/signInTaglineText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/auth_value_line"
            android:textAppearance="@style/TextAppearance.Amperly.Body"
            android:textColor="@color/amp_ink_secondary" />

        <TextView
            android:id="@+id/signInIntroText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/auth_intro"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailInputLayout"
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:hint="@string/auth_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/signInEmailEdit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:autofillHints="emailAddress"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Amperly.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordInputLayout"
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:hint="@string/auth_password"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/signInPasswordEdit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:autofillHints="password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Amperly.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/signInProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp" />

        <TextView
            android:id="@+id/signInErrorText"
            style="@style/Widget.Amperly.Notice.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:visibility="gone" />

        <TextView
            android:id="@+id/signInInfoText"
            style="@style/Widget.Amperly.Notice.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signInButton"
            style="@style/Widget.Amperly.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/auth_sign_in" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createAccountButton"
            style="@style/Widget.Amperly.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:text="@string/auth_create_account" />

        <TextView
            android:id="@+id/signInOfflineNoteText"
            style="@style/Widget.Amperly.Notice.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/auth_offline_note"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/auth_footer_note"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall"
            android:textColor="@color/amp_ink_secondary" />
    </LinearLayout>
</ScrollView>
