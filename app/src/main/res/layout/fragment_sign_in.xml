<?xml version="1.0" encoding="utf-8"?>
<!--
  Sign in / create account.

  This is the first screen whenever a Supabase project is configured, because every
  read and write in the app is authorised against the signed-in account — with no
  session, Row Level Security returns nothing and the app would look empty.

  Two ways forward are offered, and they are deliberately not equal weight:
    * sign in / create account — the real path; the server holds the data.
    * offline demo mode — the seeded pilot data, on this device only, for reviewers
      who have no account. It is a text button, and it says plainly what it does.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/amp_screen_padding"
        android:paddingBottom="@dimen/amp_space_xl">

        <TextView
            android:id="@+id/signInTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_title"
            android:textAppearance="@style/TextAppearance.Amperly.ScreenTitle" />

        <TextView
            android:id="@+id/signInIntroText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:text="@string/auth_intro"
            android:textAppearance="@style/TextAppearance.Amperly.Body" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Amperly.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/amp_space_m">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailInputLayout"
                    style="@style/Widget.Amperly.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/signInEmailEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordInputLayout"
                    style="@style/Widget.Amperly.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_s"
                    android:hint="@string/auth_password"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/signInPasswordEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/signInProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/signInErrorText"
            style="@style/Widget.Amperly.Notice.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:visibility="gone" />

        <TextView
            android:id="@+id/signInInfoText"
            style="@style/Widget.Amperly.Notice.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signInButton"
            style="@style/Widget.Amperly.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/auth_sign_in" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createAccountButton"
            style="@style/Widget.Amperly.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/auth_create_account" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueOfflineButton"
            style="@style/Widget.Amperly.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:text="@string/auth_continue_offline"
            android:visibility="gone" />

        <TextView
            android:id="@+id/signInOfflineNoteText"
            style="@style/Widget.Amperly.Notice.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/auth_offline_note"
            android:visibility="gone" />

        <TextView
            android:id="@+id/signInDemoNoteText"
            style="@style/Widget.Amperly.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/auth_demo_note" />

        <TextView
            android:id="@+id/signInPilotHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/auth_pilot_accounts"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />
    </LinearLayout>
</ScrollView>
