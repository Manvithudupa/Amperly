<?xml version="1.0" encoding="utf-8"?>
<!--
  The toolbar profile badge: the signed-in user's initials on the lime brand square, so the
  identity in the top bar reads as the same mark as the account page.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileBadge"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:layout_marginEnd="@dimen/amp_space_xs"
    android:background="@drawable/bg_brand_mark"
    android:clickable="true"
    android:contentDescription="@string/account_title"
    android:focusable="true">

    <TextView
        android:id="@+id/profileBadgeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/dm_sans"
        android:textColor="@color/amp_on_lime"
        android:textSize="13sp"
        android:textStyle="bold" />
</FrameLayout>
