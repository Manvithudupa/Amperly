<?xml version="1.0" encoding="utf-8"?>
<!--
  Host bookings tab. The dashboard owns the numbers; this screen owns the list of slots drivers
  have booked, so the two tabs no longer open the same page.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/amp_screen_padding"
    android:paddingTop="@dimen/amp_space_l"
    android:paddingEnd="@dimen/amp_screen_padding"
    android:paddingBottom="@dimen/amp_space_m">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_bookings"
        android:textAppearance="@style/TextAppearance.Amperly.Display"
        android:accessibilityHeading="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_xs"
        android:text="@string/host_bookings_intro"
        android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

    <TextView
        android:id="@+id/hostBookingsEmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_xl"
        android:gravity="center"
        android:text="@string/host_bookings_empty"
        android:textAppearance="@style/TextAppearance.Amperly.BodySmall"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hostBookingsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/amp_space_s"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="vertical" />
</LinearLayout>
