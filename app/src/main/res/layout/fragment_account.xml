<?xml version="1.0" encoding="utf-8"?>
<!--
  Profile. Identity first, then the capacity switch (moved here from the shell), then the
  account's own facts and the sync state. Rows, not a wall of cards.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_background"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.Amperly.ScreenBody"
        android:paddingTop="@dimen/amp_space_l">

        <TextView
            android:id="@+id/accountTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account_title"
            android:textAppearance="@style/TextAppearance.Amperly.Display" />

        <TextView
            android:id="@+id/accountSubtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:text="@string/account_description"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <!-- Identity -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Amperly.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/amp_space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/accountAvatarBadge"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_brand_mark">

                        <TextView
                            android:id="@+id/accountAvatarText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/pjs_bold"
                            android:textColor="@color/amp_on_primary"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/accountNameText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Amperly.Title" />

                        <TextView
                            android:id="@+id/accountEmailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    style="@style/Widget.Amperly.Divider"
                    android:layout_marginTop="@dimen/amp_space_m"
                    android:layout_marginBottom="@dimen/amp_space_s" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/amp_touch_target"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/accountAuthorityText"
                        style="@style/Widget.Amperly.Badge.Neutral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editNameButton"
                        style="@style/Widget.Amperly.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_edit_name"
                        app:icon="@drawable/ic_pencil"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="16dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Capacity switch: the one place a role is chosen. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_section_gap"
            android:text="@string/account_switch_title"
            android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/account_switch_body"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/roleChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            app:chipSpacingHorizontal="@dimen/amp_space_s"
            app:chipSpacingVertical="@dimen/amp_space_s"
            app:singleLine="false"
            app:singleSelection="true" />

        <!-- Personal details, built at runtime so labels and values stay aligned. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_section_gap"
            android:layout_marginBottom="@dimen/amp_space_xs"
            android:text="@string/account_details"
            android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Amperly.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/accountDetailContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/amp_space_m" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Sync -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_section_gap"
            android:layout_marginBottom="@dimen/amp_space_xs"
            android:text="@string/account_sync"
            android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

        <TextView
            android:id="@+id/accountSyncStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <TextView
            android:id="@+id/accountRoleNoteText"
            style="@style/Widget.Amperly.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/account_role_note" />

        <TextView
            android:id="@+id/accountDemoNoteText"
            style="@style/Widget.Amperly.Notice.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/account_demo_note"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationsButton"
            style="@style/Widget.Amperly.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/notifications_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/accountSignInButton"
            style="@style/Widget.Amperly.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/auth_sign_in"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signOutButton"
            style="@style/Widget.Amperly.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/account_sign_out" />
    </LinearLayout>
</ScrollView>
