<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Amperly.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/amp_space_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/amp_space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reservationStationText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Amperly.SectionTitle" />

            <TextView
                android:id="@+id/reservationStatusText"
                style="@style/Widget.Amperly.Badge.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s" />
        </LinearLayout>

        <TextView
            android:id="@+id/reservationSlotText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.Body" />

        <TextView
            android:id="@+id/reservationCodeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Amperly.Mono" />

        <TextView
            android:id="@+id/reservationAmountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.BodyStrong" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openQrButton"
                style="@style/Widget.Amperly.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/qr_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkInButton"
                style="@style/Widget.Amperly.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s"
                android:layout_weight="1"
                android:text="@string/session_check_in" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/messageHostButton"
                style="@style/Widget.Amperly.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/chat_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelReservationButton"
                style="@style/Widget.Amperly.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s"
                android:layout_weight="1"
                android:text="@string/action_cancel" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
