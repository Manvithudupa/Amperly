<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Amperly.Card.Plain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/amp_space_m"
    android:paddingBottom="@dimen/amp_space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/reservationStationText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

        <TextView
            android:id="@+id/reservationStatusText"
            style="@style/Widget.Amperly.Badge.Neutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/amp_space_s" />
    </LinearLayout>

    <TextView
        android:id="@+id/reservationSlotText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!--
          The booking code used to be printed here as plain text, so the only way back to the QR
          was the "View code" button below — and once the driver left the post-booking screen the
          code itself was not tappable. The chip is the code, and tapping it shows the QR at any
          time, for any reservation.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reservationCodeButton"
            style="@style/Widget.Amperly.Button.Code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="220dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/reservationAmountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Amperly.Number" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_s"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openQrButton"
            style="@style/Widget.Amperly.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/qr_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkInButton"
            style="@style/Widget.Amperly.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/amp_space_s"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/session_check_in" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/messageHostButton"
            style="@style/Widget.Amperly.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/chat_title" />

        <!--
          Cancelling is a real action with a dialog and a fee, not a quiet link. It used to be red
          text, which read as a label rather than as a button, and it shared a row with the chat
          link. It is now a red filled button on its own line, so the state of the free
          cancellation window is impossible to miss and its label has room to be read.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelReservationButton"
            style="@style/Widget.Amperly.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:minWidth="0dp"
            android:text="@string/booking_cancel_action" />
    </LinearLayout>

    <View style="@style/Widget.Amperly.Divider" />
</LinearLayout>
