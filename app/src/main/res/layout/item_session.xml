<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Amperly.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/amp_space_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/amp_space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sessionStationText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Amperly.SectionTitle" />

            <TextView
                android:id="@+id/sessionStatusText"
                style="@style/Widget.Amperly.Badge.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s" />
        </LinearLayout>

        <TextView
            android:id="@+id/sessionMetaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.Body" />

        <TextView
            android:id="@+id/sessionKwhText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Amperly.Body" />

        <TextView
            android:id="@+id/sessionTotalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.Metric" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewReceiptButton"
                style="@style/Widget.Amperly.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_view_receipt" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disputeSessionButton"
                style="@style/Widget.Amperly.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s"
                android:layout_weight="1"
                android:text="@string/action_report" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
