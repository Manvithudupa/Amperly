<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/amp_space_m"
    android:paddingBottom="@dimen/amp_space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sessionStationText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

        <TextView
            android:id="@+id/sessionStatusText"
            style="@style/Widget.Amperly.Badge.Neutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/amp_space_s" />
    </LinearLayout>

    <TextView
        android:id="@+id/sessionMetaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Amperly.Label" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_s"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sessionKwhText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Amperly.Number" />

        <TextView
            android:id="@+id/sessionTotalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Amperly.MetricSmall" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewReceiptButton"
            style="@style/Widget.Amperly.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/action_view_receipt" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/disputeSessionButton"
            style="@style/Widget.Amperly.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/amp_space_s"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/action_report" />
    </LinearLayout>

    <View style="@style/Widget.Amperly.Divider" />
</LinearLayout>
