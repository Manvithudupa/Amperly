<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/messageRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/amp_space_xs">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/messageCard"
        style="@style/Widget.Amperly.Card.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/amp_space_m">

            <TextView
                android:id="@+id/messageMetaText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Amperly.Label" />

            <TextView
                android:id="@+id/messageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Amperly.Body"
                android:textColor="@color/amp_on_surface" />

            <TextView
                android:id="@+id/messageWarningText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_xs"
                android:background="@color/amp_tertiary_container"
                android:padding="@dimen/amp_space_s"
                android:textAppearance="@style/TextAppearance.Amperly.Label"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
