<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.Amperly.ScreenBody"
        android:paddingTop="@dimen/amp_space_l">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/host_register_title"
            android:textAppearance="@style/TextAppearance.Amperly.Display"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:text="@string/host_register_intro"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <!-- ============================================================ 1 Where -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_section_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Amperly.StepNumber"
                android:text="1" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s"
                android:layout_weight="1"
                android:text="@string/host_section_location"
                android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/stationNameField"
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:hint="@string/host_station_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/stationNameEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textAppearance="@style/TextAppearance.Amperly.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/addressField"
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:hint="@string/host_address">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/addressEdit"
                style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="2"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Amperly.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/host_latitude">

                <!-- Filled by the location fix or by a chosen place; never typed. -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/latitudeEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:fontFeatureSettings="tnum"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Amperly.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s"
                android:layout_weight="1"
                android:hint="@string/host_longitude">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/longitudeEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:fontFeatureSettings="tnum"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:text="@string/host_location_auto_note"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/map_pick_hint"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Amperly.Card.Map"
            android:layout_width="match_parent"
            android:layout_height="@dimen/amp_details_map_height"
            android:layout_marginTop="@dimen/amp_space_s">

            <com.amperly.app.core.map.MapContainerView
                android:id="@+id/stationMapContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>

        <!-- The retry, and the fallback when there is no fix to retry. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/useGpsButton"
                style="@style/Widget.Amperly.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/map_pick_use_gps" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/choosePlaceButton"
                style="@style/Widget.Amperly.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/host_choose_place" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:layout_marginBottom="@dimen/amp_space_xs"
            android:text="@string/host_location_type"
            android:textAppearance="@style/TextAppearance.Amperly.LabelStrong" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/locationTypeField"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:hint="@string/host_location_type">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/locationTypeDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/host_location_type"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:hint="@string/host_operating_hours">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/hoursEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="08:00 - 20:00"
                android:textAppearance="@style/TextAppearance.Amperly.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- =========================================================== 2 Price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_section_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Amperly.StepNumber"
                android:text="2" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s"
                android:layout_weight="1"
                android:text="@string/host_section_pricing"
                android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:hint="@string/host_price">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/priceEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:inputType="numberDecimal"
                android:text="18" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Amperly's own fees: shown for transparency, never editable by the host. -->
        <TextView
            android:id="@+id/platformFeesNote"
            style="@style/Widget.Amperly.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:layout_marginBottom="@dimen/amp_space_xs"
            android:text="@string/host_meter_level"
            android:textAppearance="@style/TextAppearance.Amperly.LabelStrong" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/meterLevelField"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:hint="@string/host_meter_level">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/meterLevelDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/host_meter_level"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:text="@string/host_meter_level_note"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:hint="@string/host_access_rules">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/accessRulesEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:textAppearance="@style/TextAppearance.Amperly.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ============================================================ 3 Port -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_section_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Amperly.StepNumber"
                android:text="3" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s"
                android:layout_weight="1"
                android:text="@string/host_section_first_port"
                android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:text="@string/host_port_types_note"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />

        <!-- One row per connector type; rows are inflated from item_port_type_row. -->
        <LinearLayout
            android:id="@+id/portTypesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addPortTypeButton"
            style="@style/Widget.Amperly.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/host_add_port_type" />

        <TextView
            android:id="@+id/registerStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveStationButton"
            style="@style/Widget.Amperly.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/host_submit_station" />
    </LinearLayout>
</ScrollView>
