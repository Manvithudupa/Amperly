<?xml version="1.0" encoding="utf-8"?>
<!--
  One Google Place suggestion: the place name, with its address beneath it. Replaces the
  platform's simple_list_item_2 so the suggestion list matches the rest of the app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/amp_space_m"
    android:paddingTop="@dimen/amp_space_s"
    android:paddingEnd="@dimen/amp_space_m"
    android:paddingBottom="@dimen/amp_space_s">

    <TextView
        android:id="@+id/placePrimaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Amperly.BodyStrong"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/placeSecondaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Amperly.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
