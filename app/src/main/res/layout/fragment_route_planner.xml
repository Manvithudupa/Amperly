<?xml version="1.0" encoding="utf-8"?>
<!--
  Route and charging plan.

  Layout intent: the trip inputs are one bounded "form" card, the map is a
  feature panel, and everything the planner produces reads top-down in the order
  a driver decides: what the plan costs in time, which stop to take, what to do
  if that stop fails, what was assumed. Status panels use the shared Notice
  styles so a caution looks like a caution instead of a tinted rectangle with
  light-mode colours baked in.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/amp_screen_padding"
        android:paddingBottom="@dimen/amp_space_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/route_title"
            android:textAppearance="@style/TextAppearance.Amperly.ScreenTitle" />

        <!-- ============================================================ Inputs -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Amperly.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/amp_space_m">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Amperly.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/route_origin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/originEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mysore" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Amperly.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_s"
                    android:hint="@string/route_destination">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/destinationEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mangalore" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Paired on one row: both are short numbers, and stacking them
                     added 80dp of scrolling to every plan. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_s"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Amperly.TextInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/route_distance_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/distanceEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Amperly.TextInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/amp_space_s"
                        android:layout_weight="1"
                        android:hint="@string/route_current_soc">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/currentSocEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="55" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/socSourceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_m"
                    android:text="@string/route_corridor"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/corridorChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/corridor5Chip"
                        style="@style/Widget.Amperly.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="5 km" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/corridor10Chip"
                        style="@style/Widget.Amperly.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:checked="true"
                        android:text="10 km" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/corridor20Chip"
                        style="@style/Widget.Amperly.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="20 km" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_m"
                    android:text="@string/route_preference"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/preferenceChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="false"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/prefFastestChip"
                        style="@style/Widget.Amperly.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:checked="true"
                        android:text="@string/pref_fastest" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/prefCheapestChip"
                        style="@style/Widget.Amperly.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/pref_cheapest" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/prefReliableChip"
                        style="@style/Widget.Amperly.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/pref_reliable" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/prefShortestDetourChip"
                        style="@style/Widget.Amperly.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/pref_shortest_detour" />
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/planRouteButton"
                    style="@style/Widget.Amperly.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_m"
                    android:text="@string/route_plan_action" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- =============================================================== Map -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Amperly.Card.Map"
            android:layout_width="match_parent"
            android:layout_height="@dimen/amp_map_panel_height"
            android:layout_marginTop="@dimen/amp_space_m">

            <!-- MaterialCardView already clips its children to its rounded
                 outline, so no android:clipToOutline is needed here (that XML
                 attribute is API 31+, and would be inert on this app's minSdk). -->
            <FrameLayout
                android:id="@+id/routeMapContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================= Result -->
        <TextView
            android:id="@+id/routeSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:textAppearance="@style/TextAppearance.Amperly.BodyStrong" />

        <TextView
            android:id="@+id/confidenceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />

        <TextView
            android:id="@+id/planStatusText"
            style="@style/Widget.Amperly.Notice.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/route_recommended_stop"
            android:textAppearance="@style/TextAppearance.Amperly.SectionTitle" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/plannedStopsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/route_backups"
            android:textAppearance="@style/TextAppearance.Amperly.SectionTitle" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/backupsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/route_candidates"
            android:textAppearance="@style/TextAppearance.Amperly.SectionTitle" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/candidatesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- ======================================================== Assumptions -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/amp_space_l"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/route_assumptions"
            android:textAppearance="@style/TextAppearance.Amperly.SectionTitle" />

        <LinearLayout
            android:id="@+id/assumptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/estimateNoticeText"
            style="@style/Widget.Amperly.Notice.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/route_estimate_notice" />

        <!-- ================================================== Authoritative SoC -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Amperly.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/amp_space_m">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/soc_update_title"
                    android:textAppearance="@style/TextAppearance.Amperly.SectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_xs"
                    android:text="@string/soc_update_hint"
                    android:textAppearance="@style/TextAppearance.Amperly.Body" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Amperly.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_s"
                    android:hint="@string/route_current_soc">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/actualSocEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateSocButton"
                    style="@style/Widget.Amperly.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_s"
                    android:text="@string/soc_update_action" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/recalcContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:orientation="vertical" />

        <!-- =================================================== Out-of-range card -->
        <!--
          Shown only when the planner cannot find a safe charger. It is the one
          place the app blocks a plan, so it gets the error treatment, and the
          recovery options are ordered most-likely-first rather than presented as
          three identical buttons.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/noSafeChargerContainer"
            style="@style/Widget.Amperly.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorErrorContainer"
            app:strokeColor="?attr/colorError"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/amp_space_m">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/soc_no_safe_charger"
                    android:textAppearance="@style/TextAppearance.Amperly.SectionTitle"
                    android:textColor="?attr/colorOnErrorContainer" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_xs"
                    android:text="@string/soc_no_safe_body"
                    android:textAppearance="@style/TextAppearance.Amperly.Body"
                    android:textColor="?attr/colorOnErrorContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/widerRadiusButton"
                    style="@style/Widget.Amperly.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_m"
                    android:text="@string/soc_wider_radius" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slowerChargerButton"
                    style="@style/Widget.Amperly.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_s"
                    android:text="@string/soc_slower_charger" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/emergencyButton"
                    style="@style/Widget.Amperly.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_xs"
                    android:text="@string/soc_emergency" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
