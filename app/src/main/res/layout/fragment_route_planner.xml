<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Route Corridor Charger Planner"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#212529"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/originEdit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Origin (e.g. Mysore)"
            android:text="Mysore"
            android:background="@android:drawable/editbox_background"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/destinationEdit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Destination (e.g. Mangalore)"
            android:text="Mangalore"
            android:background="@android:drawable/editbox_background"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Starting Battery (SoC %):"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/startSocEdit"
                android:layout_width="80dp"
                android:layout_height="48dp"
                android:inputType="number"
                android:text="100"
                android:gravity="center"
                android:background="@android:drawable/editbox_background" />
        </LinearLayout>

        <Button
            android:id="@+id/planRouteBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Plan Route Corridor"
            android:layout_marginBottom="16dp" />

        <!-- Actual Dashboard SoC Override Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFF3CD">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manual Dashboard Battery Correction"
                    android:textStyle="bold"
                    android:textColor="#856404"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="If dashboard SoC differs from estimate during trip, update below for instant authoritative rerouting."
                    android:textSize="12sp"
                    android:textColor="#856404"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/actualSocEdit"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="Actual SoC (e.g. 25%)"
                        android:inputType="number"
                        android:background="@android:drawable/editbox_background"
                        android:paddingHorizontal="12dp" />

                    <Button
                        android:id="@+id/updateActualSocBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Update &amp; Reroute" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Route Results Summary -->
        <TextView
            android:id="@+id/routeSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/routeChargersRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
