<?xml version="1.0" encoding="utf-8"?>
<!--
  Route and charging plan.

  Three steps, in the order a driver thinks: where I start, where I am going, what the
  battery says. Everything after the plan button is the result, read top to bottom:
  summary, directions, stops as a timeline, then the assumptions that produced it.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_background"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.Amperly.ScreenBody"
        android:paddingTop="@dimen/amp_space_l">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/route_title"
            android:textAppearance="@style/TextAppearance.Amperly.Display"
            android:accessibilityHeading="true" />

        <!-- ========================================================== Step 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_section_gap"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Amperly.StepNumber"
                android:text="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/route_start_label"
                    android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

                <TextView
                    android:id="@+id/originText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/route_start_locating"
                    android:textAppearance="@style/TextAppearance.Amperly.Body" />

                <TextView
                    android:id="@+id/originDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/route_start_locating_address"
                    android:textAppearance="@style/TextAppearance.Amperly.Label"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/setOriginOnMapButton"
                    style="@style/Widget.Amperly.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_xs"
                    android:minWidth="0dp"
                    android:text="@string/route_start_pick_on_map"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========================================================== Step 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Amperly.StepNumber"
                android:text="2" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/amp_space_s"
                    android:text="@string/route_destination"
                    android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/destinationField"
                    style="@style/Widget.Amperly.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/route_destination_hint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/destinationEdit"
                        style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:completionThreshold="2"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/destinationResolvedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_xs"
                    android:textAppearance="@style/TextAppearance.Amperly.Label"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========================================================== Step 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Amperly.StepNumber"
                android:text="3" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/amp_space_s"
                    android:text="@string/route_battery_step"
                    android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Amperly.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/route_current_soc">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/currentSocEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textAppearance="@style/TextAppearance.Amperly.Number" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/socSourceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_xs"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />
            </LinearLayout>
        </LinearLayout>

        <!-- Plan preferences -->
        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/route_preferences_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/route_corridor"
            android:textAppearance="@style/TextAppearance.Amperly.LabelStrong" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/corridorChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/corridor5Chip"
                style="@style/Widget.Amperly.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="5 km" />

            <com.google.android.material.chip.Chip
                android:id="@+id/corridor10Chip"
                style="@style/Widget.Amperly.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:text="10 km" />

            <com.google.android.material.chip.Chip
                android:id="@+id/corridor20Chip"
                style="@style/Widget.Amperly.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="20 km" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/route_preference"
            android:textAppearance="@style/TextAppearance.Amperly.LabelStrong" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/preferenceChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleLine="false"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/prefFastestChip"
                style="@style/Widget.Amperly.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:text="@string/pref_fastest" />

            <com.google.android.material.chip.Chip
                android:id="@+id/prefCheapestChip"
                style="@style/Widget.Amperly.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/pref_cheapest" />

            <com.google.android.material.chip.Chip
                android:id="@+id/prefReliableChip"
                style="@style/Widget.Amperly.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/pref_reliable" />

            <com.google.android.material.chip.Chip
                android:id="@+id/prefShortestDetourChip"
                style="@style/Widget.Amperly.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/pref_shortest_detour" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/planRouteButton"
            style="@style/Widget.Amperly.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/route_plan_action" />

        <!-- ============================================================== Map -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Amperly.Card.Map"
            android:layout_width="match_parent"
            android:layout_height="@dimen/amp_map_panel_height"
            android:layout_marginTop="@dimen/amp_space_l">

            <com.amperly.app.core.map.MapContainerView
                android:id="@+id/routeMapContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>

        <!-- =========================================================== Result -->
        <TextView
            android:id="@+id/routeSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:textAppearance="@style/TextAppearance.Amperly.Title" />

        <TextView
            android:id="@+id/confidenceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />

        <TextView
            android:id="@+id/planStatusText"
            style="@style/Widget.Amperly.Notice.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:visibility="gone"
            android:accessibilityLiveRegion="polite" />

        <!-- Calm out-of-range panel: a heading, the truth, three alternatives. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/noSafeChargerContainer"
            style="@style/Widget.Amperly.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:visibility="gone"
            app:cardBackgroundColor="@color/amp_error_tint"
            app:strokeColor="@color/amp_error">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/amp_space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/amp_error" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/amp_space_s"
                        android:layout_weight="1"
                        android:text="@string/soc_no_safe_charger"
                        android:textAppearance="@style/TextAppearance.Amperly.TitleSmall"
                        android:textColor="@color/amp_error" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_s"
                    android:text="@string/soc_no_safe_body"
                    android:textAppearance="@style/TextAppearance.Amperly.Body"
                    android:textColor="@color/amp_ink" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/widerRadiusButton"
                    style="@style/Widget.Amperly.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_m"
                    android:text="@string/soc_wider_radius" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slowerChargerButton"
                    style="@style/Widget.Amperly.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/amp_space_s"
                    android:text="@string/soc_slower_charger" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/emergencyButton"
                    style="@style/Widget.Amperly.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/soc_emergency" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ======================================================= Directions -->
        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/route_directions_title" />

        <TextView
            android:id="@+id/directionsMetaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Amperly.LabelStrong" />

        <LinearLayout
            android:id="@+id/directionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/directionsNoteText"
            style="@style/Widget.Amperly.Notice.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/route_directions_note" />

        <!-- ============================================================ Stops -->
        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/route_recommended_stop" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/plannedStopsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/route_backups" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/backupsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/route_candidates" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/candidatesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- ======================================================= Assumptions -->
        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/route_assumptions" />

        <LinearLayout
            android:id="@+id/assumptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/estimateNoticeText"
            style="@style/Widget.Amperly.Notice.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/route_estimate_notice" />

        <!-- ================================================== Authoritative SoC -->
        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/soc_update_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/soc_update_hint"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:hint="@string/route_current_soc">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/actualSocEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textAppearance="@style/TextAppearance.Amperly.Number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/updateSocButton"
            style="@style/Widget.Amperly.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/soc_update_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startNavigationButton"
            style="@style/Widget.Amperly.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/route_start_navigation" />

        <LinearLayout
            android:id="@+id/recalcContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
