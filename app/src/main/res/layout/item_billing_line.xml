<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/amp_space_xs">

    <TextView
        android:id="@+id/lineLabelText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Amperly.Body" />

    <!-- The label is muted and the value is not, which is what makes a receipt
         row scannable instead of a run of grey text. -->
    <TextView
        android:id="@+id/lineValueText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/amp_space_s"
        android:textAppearance="@style/TextAppearance.Amperly.BodyStrong" />
</LinearLayout>
