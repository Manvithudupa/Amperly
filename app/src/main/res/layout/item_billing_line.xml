<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/amp_touch_target"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/lineLabelText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Amperly.Body"
        android:textColor="@color/amp_ink_secondary" />

    <TextView
        android:id="@+id/lineValueText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/amp_space_m"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.Amperly.Number" />
</LinearLayout>
