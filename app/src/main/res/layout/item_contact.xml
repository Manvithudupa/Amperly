<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/amp_touch_target"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/amp_space_s"
        android:paddingBottom="@dimen/amp_space_s">

        <TextView
            android:id="@+id/contactNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Amperly.BodyStrong" />

        <TextView
            android:id="@+id/contactPhoneText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/callContactButton"
        style="@style/Widget.Amperly.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/action_call"
        app:icon="@drawable/ic_phone"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconSize="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/deleteContactButton"
        style="@style/Widget.Amperly.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/amp_space_xs"
        android:minWidth="0dp"
        android:text="@string/action_close" />
</LinearLayout>
