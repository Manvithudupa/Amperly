<?xml version="1.0" encoding="utf-8"?>
<!-- Meter readings capture. Scrolls, because the note field is multiline and the keyboard
     would otherwise push the dialog's buttons off screen. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/amp_screen_padding"
        android:paddingTop="@dimen/amp_space_s"
        android:paddingEnd="@dimen/amp_screen_padding"
        android:paddingBottom="@dimen/amp_space_xs">

        <TextView
            android:id="@+id/meterEvidenceHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:hint="@string/session_start_meter">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/meterStartEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:hint="@string/session_end_meter">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/meterEndEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:hint="@string/session_note_optional">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/meterNoteEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:textAppearance="@style/TextAppearance.Amperly.Body" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
