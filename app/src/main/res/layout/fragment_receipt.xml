<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_background"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.Amperly.ScreenBody"
        android:paddingTop="@dimen/amp_space_l">

        <LinearLayout
            android:id="@+id/receiptPaidBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                app:tint="@color/amp_available" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/receipt_paid_label"
                android:textAppearance="@style/TextAppearance.Amperly.LabelStrong" />
        </LinearLayout>

        <TextView
            android:id="@+id/receiptTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:text="@string/receipt_title"
            android:textAppearance="@style/TextAppearance.Amperly.Display"
            android:accessibilityHeading="true" />

        <TextView
            android:id="@+id/receiptStationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Amperly.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/amp_space_m">

                <LinearLayout
                    android:id="@+id/receiptContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="@dimen/amp_space_m"
                    android:layout_marginBottom="@dimen/amp_space_m"
                    android:background="@drawable/bg_dashed_divider" />

                <TextView
                    android:id="@+id/receiptTotalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Amperly.Title" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/receiptDisclaimerText"
            style="@style/Widget.Amperly.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:text="@string/receipt_disclaimer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reportIssueButton"
            style="@style/Widget.Amperly.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/report_title" />
    </LinearLayout>
</ScrollView>
