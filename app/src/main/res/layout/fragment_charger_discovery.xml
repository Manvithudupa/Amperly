<?xml version="1.0" encoding="utf-8"?>
<!--
  Discover: the map is the page, the list is a sheet you can pull up.

  The floating card answers "where am I and what did I tell the app about my battery" without
  covering the map. Filters and results live in the sheet, so the map stays legible.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_background">

    <!-- Full-bleed map. It runs under the floating card and the sheet on purpose. -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/amp_map_placeholder" />

    <!-- Floating header: what this list is, and the driver's own battery reading. -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Amperly.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/amp_screen_padding"
        android:layout_marginTop="@dimen/amp_space_s"
        android:layout_marginEnd="@dimen/amp_screen_padding"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/amp_space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pin"
                    app:tint="@color/amp_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/amp_space_s"
                    android:layout_weight="1"
                    android:text="@string/discovery_title"
                    android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

                <!-- Battery is the driver's own reading, entered by hand; tapping changes it. -->
                <LinearLayout
                    android:id="@+id/heroBatteryCard"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/amp_touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/heroBatteryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="—"
                        android:textAppearance="@style/TextAppearance.Amperly.MetricSmall" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_battery"
                        app:tint="@color/amp_available" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/discoveryContextText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/heroBatteryProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    app:indicatorColor="@color/amp_available"
                    app:trackColor="@color/amp_surface_variant"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="6dp" />

                <TextView
                    android:id="@+id/heroBatteryCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/amp_space_s"
                    android:text="@string/discovery_battery_caption"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateVehicleButton"
                    style="@style/Widget.Amperly.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/vehicle_title" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- The sheet. Peek shows filters and the first charger; drag for the full list. -->
    <LinearLayout
        android:id="@+id/discoverSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet_top"
        android:orientation="vertical"
        app:behavior_fitToContents="false"
        app:behavior_hideable="false"
        app:behavior_peekHeight="280dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            style="@style/Widget.Amperly.SheetHandle"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/amp_space_s"
            android:layout_marginBottom="@dimen/amp_space_s" />

        <!-- Compact three-number summary. Not a grid of cards. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/amp_screen_padding"
            android:paddingEnd="@dimen/amp_screen_padding">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statNearbyCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="0"
                    android:textAppearance="@style/TextAppearance.Amperly.MetricSmall" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/discovery_stat_nearby"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statBestPriceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="—"
                    android:textAppearance="@style/TextAppearance.Amperly.MetricSmall" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/discovery_stat_best_price"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statRangeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="—"
                    android:textAppearance="@style/TextAppearance.Amperly.MetricSmall" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/discovery_stat_range"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:paddingStart="@dimen/amp_screen_padding"
            android:paddingEnd="@dimen/amp_screen_padding"
            android:clipToPadding="false"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filterChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/amp_space_s"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterAllChip"
                    style="@style/Widget.Amperly.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filter_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterCompatibleChip"
                    style="@style/Widget.Amperly.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_compatible" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterCampusChip"
                    style="@style/Widget.Amperly.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_campus" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterApartmentChip"
                    style="@style/Widget.Amperly.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_apartment" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterDcChip"
                    style="@style/Widget.Amperly.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_dc_fast" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterVerifiedMeterChip"
                    style="@style/Widget.Amperly.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_verified_only" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/resultCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/amp_screen_padding"
            android:layout_marginTop="@dimen/amp_space_s"
            android:layout_marginEnd="@dimen/amp_screen_padding"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/emptyStateContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/amp_screen_padding"
                    android:layout_marginTop="@dimen/amp_space_s"
                    android:layout_marginEnd="@dimen/amp_screen_padding"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/emptyStateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/discovery_empty"
                        android:textAppearance="@style/TextAppearance.Amperly.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/emptyStateActionButton"
                        style="@style/Widget.Amperly.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/amp_space_s"
                        android:text="@string/discovery_empty_action"
                        android:visibility="gone" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/stationsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="@dimen/amp_space_xl" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
