<?xml version="1.0" encoding="utf-8"?>
<!--
  Charging session.

  One number the driver glances at, two secondary facts, the demo-meter truth, then the
  readings and the stop action. Nothing here is invented: before a session exists the big
  number reads "—".
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_background"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.Amperly.ScreenBody"
        android:paddingTop="@dimen/amp_space_l">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/session_title"
            android:textAppearance="@style/TextAppearance.Amperly.Display" />

        <TextView
            android:id="@+id/sessionStateText"
            style="@style/Widget.Amperly.Badge.Neutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s" />

        <TextView
            android:id="@+id/sessionInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <!-- Live energy -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Amperly.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/amp_space_m">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/session_live_kwh_label"
                    android:textAppearance="@style/TextAppearance.Amperly.LabelStrong" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/liveKwhText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="—"
                        android:textAppearance="@style/TextAppearance.Amperly.Display"
                        android:textSize="44sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/unit_kwh"
                        android:textAppearance="@style/TextAppearance.Amperly.Body"
                        android:textColor="@color/amp_ink_secondary" />
                </LinearLayout>

                <View
                    style="@style/Widget.Amperly.Divider"
                    android:layout_marginTop="@dimen/amp_space_s"
                    android:layout_marginBottom="@dimen/amp_space_s" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/session_live_time_label"
                            android:textAppearance="@style/TextAppearance.Amperly.Label" />

                        <TextView
                            android:id="@+id/liveTimeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.Amperly.MetricSmall" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/session_live_cost_label"
                            android:textAppearance="@style/TextAppearance.Amperly.Label" />

                        <TextView
                            android:id="@+id/liveCostText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.Amperly.MetricSmall" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.Amperly.Notice.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/session_demo_meter" />

        <!-- Meter readings -->
        <TextView
            style="@style/Widget.Amperly.SectionTitle"
            android:text="@string/host_meter_evidence" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/host_record_readings"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:hint="@string/session_start_meter">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/startMeterEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textAppearance="@style/TextAppearance.Amperly.Number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:hint="@string/session_end_meter">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/endMeterEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textAppearance="@style/TextAppearance.Amperly.Number" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/captureStartButton"
                style="@style/Widget.Amperly.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/session_check_in" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/simulateButton"
                style="@style/Widget.Amperly.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/session_simulate" />
        </LinearLayout>

        <TextView
            android:id="@+id/simulateResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <!-- The state machine, stated plainly rather than drawn as a decorative stepper. -->
        <TextView
            android:id="@+id/sessionStepsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/completeSessionButton"
            style="@style/Widget.Amperly.Button.Energy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_l"
            android:text="@string/session_stop_and_bill" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startChargingButton"
            style="@style/Widget.Amperly.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/session_mark_charging" />

        <TextView
            android:id="@+id/sessionSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_m"
            android:textAppearance="@style/TextAppearance.Amperly.BodyStrong" />
    </LinearLayout>
</ScrollView>
