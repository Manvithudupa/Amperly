<?xml version="1.0" encoding="utf-8"?>
<!--
  Host messages.

  A chat screen wants all remaining vertical space for the transcript, so the
  chrome is deliberately thin: thread picker, transcript, quick questions, composer.
  The masking disclaimer is promoted to a panel because it is a privacy guarantee,
  and the moderation actions are pushed below a rule so Block is not sitting one
  thumb-slip away from Send.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/amp_screen_padding"
    android:paddingTop="@dimen/amp_space_m"
    android:paddingEnd="@dimen/amp_screen_padding">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RESERVATION CHAT"
        android:textAppearance="@style/TextAppearance.Amperly.Eyebrow" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_title"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Amperly.ScreenTitle" />

    <TextView
        android:id="@+id/maskedDisclaimerText"
        style="@style/Widget.Amperly.Notice.Info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_s"
        android:text="@string/chat_masked_disclaimer" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_s"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/threadsChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/threadTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_m"
        android:textAppearance="@style/TextAppearance.Amperly.SectionTitle" />

    <TextView
        android:id="@+id/threadExpiryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Amperly.Label" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/amp_space_s"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/chatEmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_state"
        android:textAppearance="@style/TextAppearance.Amperly.Body"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_s"
        android:text="@string/chat_quick_question"
        android:textAppearance="@style/TextAppearance.Amperly.Label" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/quickQuestionsChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_s"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Amperly.TextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/chat_input_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/chatInputEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendChatButton"
            style="@style/Widget.Amperly.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/amp_space_s"
            android:text="@string/chat_send" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/amp_space_m"
        android:background="?attr/colorOutlineVariant" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/amp_space_s"
        android:text="@string/chat_section_moderation"
        android:textAppearance="@style/TextAppearance.Amperly.Label" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/amp_space_m"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reportThreadButton"
            style="@style/Widget.Amperly.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chat_report_thread" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/blockThreadButton"
            style="@style/Widget.Amperly.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/amp_space_s"
            android:layout_weight="1"
            android:text="@string/chat_block_thread" />
    </LinearLayout>
</LinearLayout>
