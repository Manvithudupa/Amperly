<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Masked Host-Consumer Chat"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#212529"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone numbers are masked for privacy. Messages expire post-session."
        android:textSize="12sp"
        android:textColor="#6C757D"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/chatHistoryText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E9ECEF"
        android:padding="12dp"
        android:text="Consumer: Hi Host, where is the charger entrance?\nHost: Entrance is gate 2 near campus building B." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/chatInputEdit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Type quick message..."
            android:background="@android:drawable/editbox_background"
            android:paddingHorizontal="12dp" />

        <Button
            android:id="@+id/sendChatBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Send" />
    </LinearLayout>

</LinearLayout>
