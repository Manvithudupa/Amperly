<?xml version="1.0" encoding="utf-8"?>
<!--
  Charger details.

  The header answers three questions at once: is it free, how fresh is that, and what does a
  kWh cost. The day strip underneath is built from the same reservation and schedule data the
  planner uses, so it is a real availability timeline rather than decoration.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            style="@style/Widget.Amperly.ScreenBody"
            android:paddingTop="@dimen/amp_space_l">

            <!-- ======================================================= Header -->
            <TextView
                android:id="@+id/detailsNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Amperly.Display"
                android:accessibilityHeading="true" />

            <TextView
                android:id="@+id/detailsAddressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_xs"
                android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_m"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/availabilityText"
                        style="@style/Widget.Amperly.Badge.Success"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/freshnessText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.Amperly.Label" />
                </LinearLayout>

                <TextView
                    android:id="@+id/totalPerKwhText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Amperly.Metric" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/unit_per_kwh"
                    android:textAppearance="@style/TextAppearance.Amperly.Label" />
            </LinearLayout>

            <!-- Meter honesty, in words, before anything else. -->
            <TextView
                android:id="@+id/verificationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_s"
                android:textAppearance="@style/TextAppearance.Amperly.BodyStrong" />

            <TextView
                android:id="@+id/meterGatingWarningText"
                style="@style/Widget.Amperly.Notice.Warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_s"
                android:text="@string/meter_gating_warning"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/details_billing_note"
                android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

            <!-- ========================================== Availability today -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_section_gap"
                android:text="@string/details_availability_title"
                android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/details_availability_caption"
                android:textAppearance="@style/TextAppearance.Amperly.Label" />

            <LinearLayout
                android:id="@+id/availabilityTimelineContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/amp_timeline_height"
                android:layout_marginTop="@dimen/amp_space_s"
                android:baselineAligned="false"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/timelineLabelsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/timelineLegendText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/details_timeline_legend"
                android:textAppearance="@style/TextAppearance.Amperly.Label" />

            <TextView
                android:id="@+id/timelineSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

            <!-- ============================================================= Ports -->
            <TextView
                style="@style/Widget.Amperly.SectionTitle"
                android:text="@string/details_ports" />

            <LinearLayout
                android:id="@+id/portsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ========================================================== Pricing -->
            <TextView
                style="@style/Widget.Amperly.SectionTitle"
                android:text="@string/details_price_breakdown" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Amperly.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/amp_space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Widget.Amperly.RowLabel"
                            android:text="@string/line_energy_price" />

                        <TextView
                            android:id="@+id/energyPriceText"
                            style="@style/Widget.Amperly.RowValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/amp_space_s"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Widget.Amperly.RowLabel"
                            android:text="@string/line_service_fee" />

                        <TextView
                            android:id="@+id/serviceFeeText"
                            style="@style/Widget.Amperly.RowValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/amp_space_s"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Widget.Amperly.RowLabel"
                            android:text="@string/line_gateway_fee" />

                        <TextView
                            android:id="@+id/gatewayFeeText"
                            style="@style/Widget.Amperly.RowValue" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.Amperly.Divider"
                        android:layout_marginTop="@dimen/amp_space_s"
                        android:layout_marginBottom="@dimen/amp_space_s" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/details_fees_disclosed"
                        android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================================================== Directions -->
            <TextView
                style="@style/Widget.Amperly.SectionTitle"
                android:text="@string/details_directions" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Amperly.Card.Map"
                android:layout_width="match_parent"
                android:layout_height="@dimen/amp_details_map_height">

                <com.amperly.app.core.map.MapContainerView
                    android:id="@+id/detailsMapContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/travelModeChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_s"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/driveModeChip"
                    style="@style/Widget.Amperly.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/directions_drive" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/walkModeChip"
                    style="@style/Widget.Amperly.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/directions_walk" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/directionsSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_xs"
                android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

            <!-- ======================================================= Access -->
            <TextView
                style="@style/Widget.Amperly.SectionTitle"
                android:text="@string/details_access" />

            <TextView
                android:id="@+id/accessText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Amperly.Body" />

            <TextView
                android:id="@+id/incidentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_m"
                android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/amp_space_m"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/navigateDetailsButton"
                    style="@style/Widget.Amperly.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_navigate" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reportButton"
                    style="@style/Widget.Amperly.Button.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/amp_space_s"
                    android:layout_weight="1"
                    android:text="@string/action_report" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Sticky primary action: the one thing this page exists for. -->
    <LinearLayout
        style="@style/Widget.Amperly.StickyActionBar"
        android:background="@drawable/bg_sticky_bar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reserveButton"
            style="@style/Widget.Amperly.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_reserve" />
    </LinearLayout>
</LinearLayout>
