<?xml version="1.0" encoding="utf-8"?>
<!--
  One notification in its own rounded green card. The 8dp bottom margin is the gap to the next
  card; the list is clipped to its padding so the last gap is not doubled.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/amp_space_s"
    android:background="@drawable/bg_notification_card"
    android:minHeight="@dimen/amp_touch_target"
    android:orientation="horizontal"
    android:padding="@dimen/amp_space_m">

    <View
        android:id="@+id/notificationUnreadDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/amp_space_s"
        android:background="@drawable/bg_dot_lime"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notificationTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Amperly.BodyStrong" />

        <TextView
            android:id="@+id/notificationMessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <TextView
            android:id="@+id/notificationTimeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />
    </LinearLayout>
</LinearLayout>
