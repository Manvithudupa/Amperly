<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Amperly.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/amp_space_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/amp_space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stopSequenceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="28dp"
                android:textAppearance="@style/TextAppearance.Amperly.Metric" />

            <TextView
                android:id="@+id/stopNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Amperly.SectionTitle" />

            <TextView
                android:id="@+id/stopBadgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/amp_secondary_container"
                android:paddingHorizontal="@dimen/amp_space_s"
                android:paddingVertical="2dp"
                android:textAppearance="@style/TextAppearance.Amperly.Label" />
        </LinearLayout>

        <TextView
            android:id="@+id/stopDetailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.Body" />

        <TextView
            android:id="@+id/stopReasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.Mono" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reserveStopButton"
            style="@style/Widget.Amperly.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:text="@string/action_reserve" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
