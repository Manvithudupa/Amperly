<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Amperly.Card.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/amp_space_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/amp_space_m">

        <TextView
            android:id="@+id/reportTypeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Amperly.SectionTitle" />

        <TextView
            android:id="@+id/reportMetaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />

        <TextView
            android:id="@+id/reportDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.Body" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
