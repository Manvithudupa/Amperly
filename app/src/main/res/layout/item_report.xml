<?xml version="1.0" encoding="utf-8"?>
<!--
  One report, in its own tinted card. Who filed it, who it is about, what happened and when —
  then exactly three decisions: warn, suspend, or ban the reported account.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Amperly.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/amp_space_s"
    app:cardBackgroundColor="@color/amp_surface_variant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/amp_space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reportTypeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Amperly.TitleSmall" />

            <TextView
                android:id="@+id/reportStatusBadge"
                style="@style/Widget.Amperly.Badge.Neutral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s" />
        </LinearLayout>

        <TextView
            android:id="@+id/reportReporterText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />

        <TextView
            android:id="@+id/reportTargetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />

        <TextView
            android:id="@+id/reportDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.BodySmall" />

        <TextView
            android:id="@+id/reportDateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_xs"
            android:textAppearance="@style/TextAppearance.Amperly.Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/amp_space_s"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportWarningButton"
                style="@style/Widget.Amperly.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/admin_report_action_warning" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportSuspendButton"
                style="@style/Widget.Amperly.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/admin_report_action_suspend" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportBanButton"
                style="@style/Widget.Amperly.Button.Danger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/amp_space_s"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/admin_report_action_ban" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
