<?xml version="1.0" encoding="utf-8"?>
<!-- Circular badge behind the brand mark. Uses the theme role rather than a fixed green so
     it inverts correctly in dark mode instead of showing a bright disc on a dark surface. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/colorPrimaryContainer" />
</shape>
