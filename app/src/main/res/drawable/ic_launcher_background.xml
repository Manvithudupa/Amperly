<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background: near-black green, lit from the top left.

  The dark ground is what makes the lime mark in front of it read at a glance, and it is the
  same family as the app's deep green primary rather than a neutral black. The lime glow is
  the palette's energy role at low alpha, so the plate looks lit rather than flat without
  competing with the letter on top of it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="44"
                android:endY="108"
                android:type="linear">
                <item android:color="#FF15493C" android:offset="0.0" />
                <item android:color="#FF0B2C25" android:offset="0.55" />
                <item android:color="#FF05120E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="26"
                android:centerY="14"
                android:gradientRadius="98"
                android:type="radial">
                <item android:color="#40F2A516" android:offset="0.0" />
                <item android:color="#12F2A516" android:offset="0.55" />
                <item android:color="#00F2A516" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
