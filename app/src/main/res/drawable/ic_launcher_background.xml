<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background: the near-black plate the mark sits on.

  Two layers: a very dark blue-black diagonal gradient for depth, and a soft mint glow
  in the upper-left corner that reads as the light source the green letter is lit by.
  No art here — the mark lives in ic_launcher_foreground so the two never collide.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="8"
                android:startY="4"
                android:endX="100"
                android:endY="108"
                android:type="linear">
                <item android:color="#FF191C22" android:offset="0.0" />
                <item android:color="#FF101217" android:offset="0.55" />
                <item android:color="#FF08090C" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="24"
                android:centerY="18"
                android:gradientRadius="86"
                android:type="radial">
                <item android:color="#3338E0A5" android:offset="0.0" />
                <item android:color="#0F38E0A5" android:offset="0.55" />
                <item android:color="#0038E0A5" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
