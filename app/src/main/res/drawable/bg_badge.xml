<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded status pill. Previously the verification badge was a raw colour with no corner
     radius, which read as an accidental rectangle. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/amp_badge_bg" />
    <corners android:radius="100dp" />
</shape>
