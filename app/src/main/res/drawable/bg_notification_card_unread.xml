<?xml version="1.0" encoding="utf-8"?>
<!-- An unread notification: the same green card, one step stronger and outlined. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/amp_available_tint" />
    <stroke
        android:width="1dp"
        android:color="@color/amp_available" />
    <corners android:radius="@dimen/amp_card_radius" />
</shape>
