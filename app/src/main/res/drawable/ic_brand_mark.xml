    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:scaleX="0.4"
        android:scaleY="0.4"
        android:translateX="-9.9"
        android:translateY="-0.8">

        <path android:pathData="M34,68 L54,34" android:strokeWidth="11"
            android:strokeLineCap="round" android:fillColor="#00000000">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="30" android:startY="30"
                    android:endX="78" android:endY="76"
                    android:type="linear">
                    <item android:color="#FF4FE3A6" android:offset="0.0" />
                    <item android:color="#FF3AC9CE" android:offset="0.5" />
                    <item android:color="#FF2B7CF6" android:offset="1.0" />
