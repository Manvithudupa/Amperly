<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: the Amperly mark from the brand sheet.

  Three parts, in paint order:
    1. the A — two round-capped legs, one strokes mint at the top through to blue at the
       feet, so the letter carries the logo's green-to-blue sweep;
    2. the road — a dark ribbon with white lane dashes cutting across the left leg, the
       travel half of the product;
    3. the plug and its cable — mint, reaching in from the upper right, the energy half.

  Everything stays inside a 32dp radius of the centre, comfortably within the 66dp
  adaptive-icon safe zone, so no launcher mask crops the mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- A: apex 54,34 · feet 34,68 and 74,68 · stroke 11, round caps. -->
    <path
        android:pathData="M34,68 L54,34"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="30"
                android:endX="78"
                android:endY="76"
                android:type="linear">
                <item android:color="#FF4FE3A6" android:offset="0.0" />
                <item android:color="#FF3AC9CE" android:offset="0.5" />
                <item android:color="#FF2B7CF6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M54,34 L74,68"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="30"
                android:endX="78"
                android:endY="76"
                android:type="linear">
                <item android:color="#FF4FE3A6" android:offset="0.0" />
                <item android:color="#FF3AC9CE" android:offset="0.5" />
                <item android:color="#FF2B7CF6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Road: dark ribbon across the left leg, then four lane dashes on top. -->
    <path
        android:pathData="M32,79 Q44,70 63,62"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:strokeColor="#FF0B0D11" />
    <path android:pathData="M35.5,76.3 L38.6,74.8" android:strokeWidth="2.8"
        android:strokeLineCap="round" android:strokeColor="#FFF3F7F6" />
    <path android:pathData="M43.2,72.4 L46.4,70.7" android:strokeWidth="2.8"
        android:strokeLineCap="round" android:strokeColor="#FFF3F7F6" />
    <path android:pathData="M50.9,68.2 L54.2,66.3" android:strokeWidth="2.8"
        android:strokeLineCap="round" android:strokeColor="#FFF3F7F6" />
    <path android:pathData="M58.3,63.9 L61.4,61.9" android:strokeWidth="2.8"
        android:strokeLineCap="round" android:strokeColor="#FFF3F7F6" />

    <!-- Cable from the plug into the road, then the plug body and its two pins. -->
    <path
        android:pathData="M73,48 Q68,55 60.5,61"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:strokeColor="#FF4FE3A6" />
    <path
        android:pathData="M72.5,43.4 L77.5,42.2 A4.2,4.2 0 0 1 82.3,46 L82.3,49 A4.2,4.2 0 0 1 77,52.4 L72.6,50.6 A4.2,4.2 0 0 1 70.4,47 A4.2,4.2 0 0 1 72.5,43.4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="70"
                android:startY="42"
                android:endX="84"
                android:endY="53"
                android:type="linear">
                <item android:color="#FF5AE8AE" android:offset="0.0" />
                <item android:color="#FF35D3A0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M76,42.6 L79.4,36.9" android:strokeWidth="2.6"
        android:strokeLineCap="round" android:strokeColor="#FF4FE3A6" />
    <path android:pathData="M80.6,44.6 L84,38.9" android:strokeWidth="2.6"
        android:strokeLineCap="round" android:strokeColor="#FF4FE3A6" />
</vector>
