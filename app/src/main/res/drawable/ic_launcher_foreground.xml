<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: the letter A, crossbarred by a lightning bolt.

  The A is one closed contour — two legs and a solid apex, with the counter opening downward —
  so it stays crisp at 48dp and needs no masking trick. The bolt is the second path: it spans
  the gap between the legs exactly where a crossbar would sit, and its arms run into the legs,
  which ties the two shapes into one mark instead of a letter with a sticker on it.

  Both paths carry the same lime-to-amber gradient (the palette's energy role) so the overlap
  where the bolt meets the legs is invisible. Everything is inside a 30dp radius of the
  centre, comfortably within the 66dp safe zone, so no launcher mask crops the letter.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- A: apex 26, counter from 44, baseline 76, legs 11 wide. -->
    <path
        android:pathData="M46,26 L62,26 L74,76 L63,76 L54,44 L45,76 L34,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="26"
                android:endX="54"
                android:endY="77"
                android:type="linear">
                <item android:color="#FFF9EDB4" android:offset="0.0" />
                <item android:color="#FFF7C64F" android:offset="0.52" />
                <item android:color="#FFF2A516" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The crossbar: a bolt bridging the counter between the two legs. -->
    <path
        android:pathData="M50,74.9 L48.4,74.9 L50,65.8 L44.1,65.8 L54,51.1 L55.6,51.1 L54,60.2 L59.9,60.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="26"
                android:endX="54"
                android:endY="77"
                android:type="linear">
                <item android:color="#FFF9EDB4" android:offset="0.0" />
                <item android:color="#FFF7C64F" android:offset="0.52" />
                <item android:color="#FFF2A516" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
