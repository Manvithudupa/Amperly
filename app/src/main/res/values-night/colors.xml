<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Night theme: soft charcoal with a green cast, never pure black and never neon.
      Cards sit one step lighter than the background, so the paper/card hierarchy survives.
    -->

    <!-- Surfaces -->
    <color name="amp_background">#151A17</color>
    <color name="amp_surface">#1E2521</color>
    <color name="amp_surface_variant">#2A322C</color>
    <color name="amp_divider">#333D36</color>
    <color name="amp_outline">#46524A</color>

    <!-- Ink -->
    <color name="amp_ink">#E9EFE9</color>
    <color name="amp_ink_secondary">#A9B7AD</color>

    <!-- Primary: softened mint green; its "on" colour is dark so white is never used on it -->
    <color name="amp_primary">#6FD0B6</color>
    <color name="amp_primary_dark">#8FE0C9</color>
    <color name="amp_primary_tint">#22352E</color>
    <color name="amp_on_primary">#0C2B24</color>
    <color name="amp_on_primary_tint">#C7EFE3</color>

    <!-- Energy: softened amber -->
    <color name="amp_energy">#F0B65A</color>
    <color name="amp_energy_tint">#3A2F1B</color>
    <color name="amp_on_energy">#241A08</color>

    <!-- Status -->
    <color name="amp_available">#7FD39A</color>
    <color name="amp_available_tint">#20342A</color>
    <color name="amp_busy">#E8B25F</color>
    <color name="amp_busy_ink">#F0C27C</color>
    <color name="amp_busy_tint">#382C18</color>
    <color name="amp_error">#F0A69C</color>
    <color name="amp_error_tint">#3C211E</color>
    <color name="amp_info">#9CC3E5</color>
    <color name="amp_info_tint">#1E2E3D</color>

    <!-- Legacy role names -->
    <color name="amp_primary_container">@color/amp_primary_tint</color>
    <color name="amp_on_secondary_container">#D3E5F5</color>
    <color name="amp_on_error_container">#FFDAD4</color>
    <color name="amp_surface_container_low">#1B211D</color>
    <color name="amp_surface_container_high">#303A33</color>
    <color name="amp_surface_container_highest">#37423A</color>
    <color name="amp_map_placeholder">#232B25</color>
</resources>
