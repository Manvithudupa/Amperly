<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Night palette for the prototype's design language.

      The rule is the same as in light mode, only inverted: cards are one step LIGHTER than
      the background, so the white-card-on-paper hierarchy survives. Every surface role used
      by the theme is defined here so the night theme never falls back to a light colour.
    -->

    <!-- In dark mode lime becomes the primary, because it is the only tone that carries
         against a near-black background. Its "on" colour is dark green, never white. -->
    <color name="amp_primary">#9CE96A</color>
    <color name="amp_primary_dark">#7ED24E</color>
    <color name="amp_primary_light">#B6F28F</color>
    <color name="amp_primary_container">#23422F</color>
    <color name="amp_on_primary_container">#DCF6CC</color>

    <color name="amp_lime">#9CE96A</color>
    <color name="amp_lime_deep">#B6F28F</color>
    <color name="amp_lime_soft">#223528</color>
    <color name="amp_lime_tint">#1B2A20</color>
    <color name="amp_on_lime">#163F34</color>

    <color name="amp_secondary">#B8DDFF</color>
    <color name="amp_secondary_container">#1B3A52</color>
    <color name="amp_on_secondary_container">#CFE7FF</color>

    <color name="amp_tertiary">#FFC876</color>
    <color name="amp_tertiary_container">#3E2C15</color>
    <color name="amp_on_tertiary_container">#FFE3BB</color>

    <color name="amp_error">#FF8F7C</color>
