<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Only the genuine deltas live here.

      The palette itself lives in values-night/colors.xml, so every role in
      Base.Theme.Amperly resolves correctly in both modes. Redefining a style in
      values-night REPLACES it rather than merging, so nothing else is repeated here.
    -->

    <style name="Theme.Amperly" parent="Base.Theme.Amperly">
        <!-- Dark surfaces mean light system-bar icons. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
