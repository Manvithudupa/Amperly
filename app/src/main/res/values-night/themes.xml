<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Amperly" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/amp_primary_light</item>
        <item name="colorOnPrimary">@color/amp_on_primary_container</item>
        <item name="colorPrimaryContainer">@color/amp_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/amp_primary_container</item>

        <item name="colorSecondary">@color/amp_secondary</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">#0F1512</item>
        <item name="colorSurface">#161D1A</item>
        <item name="colorSurfaceVariant">#26302B</item>
        <item name="colorOnSurface">#E2EAE5</item>
        <item name="colorOnSurfaceVariant">#B4C1BA</item>
        <item name="colorOutline">#4A5550</item>

        <item name="android:statusBarColor">#0F1512</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.Amperly" parent="Base.Theme.Amperly" />

    <style name="Widget.Amperly.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/amp_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/amp_outline</item>
        <item name="cardBackgroundColor">@color/amp_surface_variant</item>
    </style>

    <style name="Widget.Amperly.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/amp_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/amp_surface_variant</item>
    </style>

    <style name="Widget.Amperly.StatTile" parent="Widget.Amperly.Card.Filled">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/amp_stat_tile_height</item>
        <item name="android:layout_margin">@dimen/amp_space_xs</item>
    </style>
</resources>
